---
/* The post editor: the body of /me/posts/<id>/edit, and of the test page /dev/editor, which passes a
 * sample post and its own endpoints (src/pages/dev). editor.js takes over the form: it builds the
 * toolbar, autosaves to data-save and uploads through data-upload; the hidden content_html, content_json
 * and dir fields are how it hands the latest copy to the form's own submit. "locked" disables the fields
 * and editor.js starts read-only. Reviewer notes are shown above the form. */
import '../styles/editor.css';
type Urls = { save: string; upload: string; preview: string; submit: string; delete: string };
const {
  post,
  notes = [],
  locked = false,
  urls: given,
} = Astro.props as {
  post: any;
  notes?: { comment: string; created_at: string }[];
  locked?: boolean;
  urls?: Urls;
};
const urls: Urls = given || {
  save: `/api/posts/${post.id}`,
  upload: '/api/upload',
  preview: `/me/posts/${post.id}/preview`,
  submit: `/api/posts/${post.id}/submit`,
  delete: `/api/posts/${post.id}`,
};
const categories = ['News', 'Event recap', 'Tutorial', 'Project', 'Experience', 'Opinion', 'Announcement'];
---

<Fragment>
  {locked && (
    <p class="flash--ok">This post is {post.status.replace('_', ' ')}. Editing reopens once a reviewer answers.</p>
  )}
  {notes.length > 0 && (
    <div class="card" style="margin-bottom:16px">
      <h2 class="h3">Reviewer notes</h2>
      <ul>
        {notes.map((n: any) => (
          <li>
            <span class="mono">{String(n.created_at).slice(0, 10)}</span> · {n.comment}
          </li>
        ))}
      </ul>
    </div>
  )}
  <form
    data-astro-reload
    class="editor"
    data-editor
    data-post-id={post.id}
    data-status={post.status}
    data-dir={post.dir}
    data-upload={urls.upload}
    data-save={urls.save}
    data-preview={urls.preview}
    method="post"
    action={urls.submit}
  >
    <div class="field">
      <label for="title">Title</label>
      <input
        class="editor__title input"
        id="title"
        name="title"
        value={post.title}
        maxlength="140"
        required
        disabled={locked}
      />
    </div>
    <div class="form__row">
      <div class="field">
        <label for="excerpt">Summary (shown in the list)</label>
        <input class="input" id="excerpt" name="excerpt" value={post.excerpt || ''} maxlength="200" disabled={locked} />
      </div>
      <div class="field">
        <label for="category">Category</label>
        <select class="select" id="category" name="category" disabled={locked}>
          {categories.map((c) => (
            <option value={c} selected={post.category === c}>
              {c}
            </option>
          ))}
        </select>
      </div>
    </div>
    <div class="field">
      <label for="tags">Tags</label>
      <input
        class="input"
        id="tags"
        name="tags"
        value={(post.tags || []).join(', ')}
        placeholder="comma separated"
        disabled={locked}
      />
    </div>
    <div class="editor__toolbar" data-editor-toolbar></div>
    <div class="editor__surface" data-editor-surface></div>
    <textarea name="content_html" hidden data-editor-html>{post.content_html || ''}</textarea>
    <textarea
      name="content_json"
      hidden
      data-editor-json
    >{post.content_json ? JSON.stringify(post.content_json) : ''}</textarea>
    <input type="hidden" name="dir" value={post.dir} data-editor-dir />
    <p class="editor__status" data-editor-status aria-live="polite">
      {locked ? 'Read only' : 'Saved'}
    </p>
    <div class="form__actions">
      <button type="button" class="btn btn--ghost" data-editor-preview>
        Preview
      </button>
      {!locked && (
        <button type="submit" class="btn" name="action" value="submit">
          Submit for review <span aria-hidden="true">→</span>
        </button>
      )}
      {post.status === 'published' && <span class="live">Edits go live in about a minute</span>}
    </div>
  </form>
  {!locked && (
    <form
      data-astro-reload
      method="post"
      action={urls.delete}
      style="margin-top:24px"
      onsubmit="return confirm('Delete this post?')"
    >
      <input type="hidden" name="_method" value="DELETE" />
      <button class="btn btn--tiny btn--danger" type="submit">
        Delete post
      </button>
    </form>
  )}
</Fragment>

<script>
  import '../scripts/editor.js';
</script>
