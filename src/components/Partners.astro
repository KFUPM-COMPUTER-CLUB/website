---
// Friends of the club, laid out as a centred tree of logos. Content comes from the partners table
// (or src/data/partners.json as seed). The click goes to the post that shows the collaboration
// ("source") or the organisation's site; the "what" field is the hover text.
import { getPartners, getSettings } from '../lib/content';
const all = await getPartners();
// The button goes to the club's link page (Admin → Settings → Links → Partner with us); falls back to the Community page.
const partnerHref = (await getSettings()).links.partner || '/community';
const partnerExt = partnerHref.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
const friends = all.filter((c) => c.kind !== 'visited');
const href = (e: { sourceUrl: string | null; url: string | null }) => e.sourceUrl || e.url || undefined;
import { t, type Lang } from '../lib/i18n';
const lang = (Astro.currentLocale ?? 'en') as Lang;
---

<section class="section partners bg-black" data-bg="#0B0B0F">
  <div class="container partners__inner">
    <span class="eyebrow reveal">{t(lang, 'home.friendsEyebrow')}</span>
    {/* set:html only for the <b>: the string comes from our own i18n files, never from a user. */}
    <p class="partners__lead reveal" set:html={t(lang, 'home.friendsLead')} />

    <ul class="logo-tree reveal">
      {friends.map((c) => (
        <li>
          <a
            href={href(c)}
            target="_blank"
            rel="noopener"
            title={c.what}
            aria-label={c.what ? `${c.name}: ${c.what}` : c.name}
          >
            {c.logo && c.mark ? (
              <span class={`logo-tree__pair${c.square ? ' logo-tree__pair--square' : ''}`}>
                <img src={c.logo.src} alt="" loading="lazy" />
                <span class="logo-tree__text">{c.name}</span>
              </span>
            ) : c.logo ? (
              <img class={c.tall ? 'logo-tree__img--tall' : undefined} src={c.logo.src} alt={c.name} loading="lazy" />
            ) : (
              <span class={`logo-tree__text${c.kind === 'kfupm_unit' ? ' logo-tree__text--kfupm' : ''}`}>{c.name}</span>
            )}
          </a>
        </li>
      ))}
    </ul>

    <div class="partners__ask reveal" id="partner">
      <a class="btn btn--light" data-magnet href={partnerHref} {...partnerExt}>
        {t(lang, 'home.partner')} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
