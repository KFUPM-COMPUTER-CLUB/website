---
import site from '../data/site.json';

// Values in site.json that still contain "REPLACE" are hidden until real content is entered.
const isReal = (value) => typeof value === 'string' && !value.includes('REPLACE');

const explore = [
  { href: '/events', label: 'Events' },
  { href: '/news', label: 'News' },
  { href: '/newsletter', label: 'Newsletter' },
  { href: '/write', label: 'Write for us' },
  { href: '/about', label: 'About' },
];

const takePart = [
  { href: isReal(site.links.join) ? site.links.join : '/about', label: 'Become a member' },
  { href: isReal(site.links.newsletterSubscribe) ? site.links.newsletterSubscribe : '/newsletter', label: 'Subscribe to the newsletter' },
  { href: isReal(site.links.writeForUs) ? site.links.writeForUs : '/write', label: 'Write an article' },
];

const socialLabels = {
  instagram: 'Instagram',
  x: 'X',
  linkedin: 'LinkedIn',
  discord: 'Discord',
  whatsapp: 'WhatsApp',
  github: 'GitHub',
};
const follow = Object.entries(socialLabels)
  .filter(([key]) => isReal(site.links[key]))
  .map(([key, label]) => ({ href: site.links[key], label }));

const ext = (href) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="site-logo" href="/" aria-label={`${site.name} home`}>
          <img src="/logo.png" alt="" width="68" height="36" />
          <span class="site-logo__text">{site.short}</span>
        </a>
        <p>{site.description}</p>
        {isReal(site.email) && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
      </div>

      <div>
        <h4>Explore</h4>
        <ul>{explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>

      <div>
        <h4>Take part</h4>
        <ul>{takePart.map((l) => <li><a href={l.href} {...ext(l.href)}>{l.label}</a></li>)}</ul>
      </div>

      <div>
        <h4>Follow</h4>
        <ul>{follow.map((l) => <li><a href={l.href} {...ext(l.href)}>{l.label}</a></li>)}</ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site.name}. A student club.</p>
      <p><a href="/about">Built by the CC website team</a></p>
    </div>
  </div>
</footer>
