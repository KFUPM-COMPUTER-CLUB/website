---
import logoSmDark from '../data/brand/logo-color-ondark-sm.png';
// Impact as a pinned show reel. A tall section keeps a full-screen stage sticky while the user
// scrolls; scroll progress (or hovering a semester) picks the active scene, and the backdrop
// photo crossfades. Content comes from the impact tables (or src/data/impact.json as seed). Under prefers-reduced-motion
// the section is not pinned and one static photo is shown.
import { Image } from 'astro:assets';
import { getImpact, getSettings } from '../lib/content';
const settings = await getSettings();
const scenes = (await getImpact())
  .filter((s) => s.totalSar && s.img)
  .sort((a, b) => Number(b.term.slice(-4)) - Number(a.term.slice(-4)) || (a.term.startsWith('Fall') ? -1 : 1));
const sar = (n: number) => n.toLocaleString('en-US');
const totalNum = settings.home.totalPrizesSar;
const stats = settings.home.stats;
---

<section class="reel bg-black" data-bg="#0B0B0F" data-reel style={`--n:${scenes.length}`} id="impact">
  <div class="reel__stage">
    <div class="reel__backdrops" aria-hidden="true">
      {scenes.map((s, i) => (
        <div class="reel__scene" data-scene={i} data-active={i === 0 ? '' : undefined}>
          <img
            src={s.img!.src}
            srcset={s.img!.srcset}
            sizes="100vw"
            alt=""
            width="1600"
            height="1000"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))}
      <div class="reel__beam"></div>
      <div class="reel__grain"></div>
      <div class="reel__shade"></div>
    </div>

    <div class="reel__content">
      <Image class="reel__icon" src={logoSmDark} alt="" width={64} densities={[1, 2]} />
      <p class="reel__big">
        <strong data-count={totalNum}>{sar(totalNum)}</strong>+ SAR
      </p>
      <p class="reel__line">in prizes offered since 2023</p>

      <ul class="reel__list">
        {scenes.map((s, i) => (
          <li>
            <button type="button" class="reel__link" data-index={i} data-active={i === 0 ? '' : undefined}>
              <span>{s.term}</span>
              <i aria-hidden="true">·</i>
              <span>
                {sar(s.totalSar!)}
                {s.isMinimum && '+'}
              </span>
            </button>
          </li>
        ))}
      </ul>

      <div class="reel__events">
        {scenes.map((s, i) => (
          <p data-events={i} hidden={i !== 0}>
            {s.items
              .filter((e) => e.prizeSar)
              .map((e, k) => (
                <>
                  {k > 0 && <span aria-hidden="true"> · </span>}
                  <a href={e.sourceUrl || '#'} target="_blank" rel="noopener">
                    {e.name.replace(/\s*\(.*\)$/, '')} {sar(e.prizeSar!)} SAR
                  </a>
                </>
              ))}
          </p>
        ))}
      </div>

      <div class="reel__stats">
        {stats.map((t) => (
          <div>
            <strong>
              {t.v} <small>{t.u}</small>
            </strong>
            <span>{t.l}</span>
          </div>
        ))}
      </div>
      <p class="reel__print mono">Prize pools as announced in club posts.</p>
    </div>
  </div>
</section>

<script>
  import '../scripts/show-reel.js';
</script>
