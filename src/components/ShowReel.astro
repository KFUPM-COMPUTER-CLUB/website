---
import logoSmDark from '../assets/brand/logo-color-ondark-sm.png';
// Impact as a pinned show reel. A tall section keeps a full-screen stage sticky while the user
// scrolls; scroll progress (or hovering a semester) picks the active scene, and the backdrop
// photo crossfades. Content comes from the impact tables (or src/data/impact.json as seed). Under prefers-reduced-motion
// the section is not pinned and one static photo is shown.
import { Image } from 'astro:assets';
import { getImpact, getSettings } from '../lib/content';
const settings = await getSettings();
const scenes = (await getImpact()).filter((s) => s.totalSar && s.img).sort((a, b) => Number(b.term.slice(-4)) - Number(a.term.slice(-4)) || (a.term.startsWith('Fall') ? -1 : 1));
const sar = (n: number) => n.toLocaleString('en-US');
const totalNum = settings.home.totalPrizesSar;
const stats = settings.home.stats;
---

<section class="reel bg-black" data-bg="#0B0B0F" data-reel style={`--n:${scenes.length}`} id="impact">
  <div class="reel__stage">
    <div class="reel__backdrops" aria-hidden="true">
      {scenes.map((s, i) => (
        <div class="reel__scene" data-scene={i} data-active={i === 0 ? '' : undefined}>
          <img src={s.img!.src} srcset={s.img!.srcset} sizes="100vw" alt="" width="1600" height="1000" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        </div>
      ))}
      <div class="reel__beam"></div>
      <div class="reel__grain"></div>
      <div class="reel__shade"></div>
    </div>

    <div class="reel__content">
      <Image class="reel__icon" src={logoSmDark} alt="" width={64} densities={[1, 2]} />
      <p class="reel__big"><strong data-count={totalNum}>{sar(totalNum)}</strong>+ SAR</p>
      <p class="reel__line">in prizes offered since 2023</p>

      <ul class="reel__list">
        {scenes.map((s, i) => (
          <li>
            <button type="button" class="reel__link" data-index={i} data-active={i === 0 ? '' : undefined}>
              <span>{s.term}</span><i aria-hidden="true">·</i><span>{sar(s.totalSar!)}{s.isMinimum && '+'}</span>
            </button>
          </li>
        ))}
      </ul>

      <div class="reel__events">
        {scenes.map((s, i) => (
          <p data-events={i} hidden={i !== 0}>
            {s.items.filter((e) => e.prizeSar).map((e, k) => <>{k > 0 && <span aria-hidden="true"> · </span>}<a href={e.sourceUrl || '#'} target="_blank" rel="noopener">{e.name.replace(/\s*\(.*\)$/, '')} {sar(e.prizeSar!)} SAR</a></>)}
          </p>
        ))}
      </div>

      <div class="reel__stats">
        {stats.map((t) => <div><strong>{t.v} <small>{t.u}</small></strong><span>{t.l}</span></div>)}
      </div>
      <p class="reel__print mono">Prize pools as announced in club posts.</p>
    </div>
  </div>
</section>

<script>
  import { onPage, reduceMotion, listen, bag } from '../scripts/page.js';
  onPage(() => {
    const reel = document.querySelector('[data-reel]');
    if (!reel) return;
    const off = bag();
    const reduce = reduceMotion();
    const scenes = [...reel.querySelectorAll('[data-scene]')];
    const links = [...reel.querySelectorAll('.reel__link')];
    const events = [...reel.querySelectorAll('[data-events]')];
    const n = scenes.length;
    let active = 0, hovered = -1;
    const show = (i) => {
      if (i === active) return; active = i;
      scenes.forEach((s, k) => k === i ? s.setAttribute('data-active', '') : s.removeAttribute('data-active'));
      links.forEach((l, k) => k === i ? l.setAttribute('data-active', '') : l.removeAttribute('data-active'));
      events.forEach((e, k) => { e.hidden = k !== i; });
    };
    links.forEach((l, i) => {
      l.addEventListener('pointerenter', () => { hovered = i; show(i); });
      l.addEventListener('pointerleave', () => { hovered = -1; });
      l.addEventListener('click', () => show(i));
    });
    if (!reduce) {
      reel.setAttribute('data-pinned', '');
      const onScroll = () => {
        if (hovered >= 0) return;
        const r = reel.getBoundingClientRect(); const span = r.height - window.innerHeight;
        if (span <= 0) return;
        const p = Math.min(1, Math.max(0, -r.top / span));
        show(Math.min(n - 1, Math.floor(p * n)));
      };
      off.add(listen(window, 'scroll', onScroll, { passive: true })); onScroll();
    }
    // The headline counts up once, the first time the stage is seen.
    const el = reel.querySelector('[data-count]');
    let io;
    if (el && !reduce && 'IntersectionObserver' in window) {
      const target = Number(el.dataset.count); el.textContent = '0';
      io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return; io.disconnect();
        const start = performance.now();
        const step = (t) => { const p = Math.min(1, (t - start) / 1800); el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))).toLocaleString('en-US'); if (p < 1) requestAnimationFrame(step); };
        requestAnimationFrame(step);
      }, { threshold: 0.3 });
      io.observe(el);
    }
    return () => { off.flush(); io?.disconnect(); };
  });
</script>
