---
import { Image } from 'astro:assets';
import logoSm from '../assets/brand/logo-color-sm.png';
import logoSmDark from '../assets/brand/logo-color-ondark-sm.png';
import site from '../data/site.json';
import NextEvent from './NextEvent.astro';

// The logo is the home link. Everything else lives in these five entries.
const links = [
  { href: '/timeline', label: 'Timeline' },
  { href: '/blog', label: 'Blog' },
  { href: '/officers', label: 'Officers' },
  { href: '/faq', label: 'FAQ' },
];

const joinHref = site.links.join.includes('REPLACE') ? '/about' : site.links.join;
const external = joinHref.startsWith('http');
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container site-header__inner">
    <div class="site-header__brand">
      <a class="site-logo" href="/" aria-label={`${site.name} home`} aria-current={path === '/' ? 'page' : undefined}>
        <span class="site-logo__stack"><Image class="site-logo__icon" src={logoSm} alt="" width={64} densities={[1, 2, 3]} /><Image class="site-logo__icon site-logo__icon--dark" src={logoSmDark} alt="" width={64} densities={[1, 2, 3]} /></span>
        <span class="site-logo__words"><span lang="ar" dir="rtl">نادي الحاسب الآلي</span><b>Computer Club</b></span>
      </a>
      <NextEvent variant="bar" />
    </div>

    <div class="site-header__end">
      <nav id="site-nav" class="site-nav" aria-label="Main">
        <NextEvent variant="menu" />
        {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
        <a class="btn btn--small" data-magnet href={joinHref} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>Join <span aria-hidden="true">→</span></a>
      </nav>
      <div class="site-header__tools">
        <button type="button" class="term-open" data-term-open aria-label="Open terminal" title="Terminal">&gt;_</button>
        <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu">Menu</button>
      </div>
    </div>
  </div>
</header>

<script>
  import '../scripts/header.js';
</script>
