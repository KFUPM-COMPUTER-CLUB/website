---
/* Site header: logo, the main links, the next-event pill and the Join button. It renders inside cached
 * public pages, so it cannot know who is viewing; the Join button carries data-join and account.js
 * turns it into "My account" on the client when the cc_in cookie is present. The Join link may be an
 * external form when settings.links.join is set. */
import { Image } from 'astro:assets';
import logoSm from '../data/brand/logo-color-sm.png';
import logoSmDark from '../data/brand/logo-color-ondark-sm.png';
import { getSettings } from '../lib/content';
const settings = await getSettings();
const site = { name: settings.site.name, links: settings.links };
import NextEvent from './NextEvent.astro';

// The logo is the home link. Everything else lives in these five entries.
const links = [
  { href: '/timeline', label: 'Timeline' },
  { href: '/blog', label: 'Blog' },
  { href: '/community', label: 'Community' },
  { href: '/faq', label: 'FAQ' },
];

const joinHref = site.links.join || '/join';
const external = joinHref.startsWith('http');
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container site-header__inner">
    <div class="site-header__brand">
      <a class="site-logo" href="/" aria-label={`${site.name} home`} aria-current={path === '/' ? 'page' : undefined}>
        <span class="site-logo__stack">
          <Image class="site-logo__icon" src={logoSm} alt="" width={64} densities={[1, 2, 3]} />
          <Image
            class="site-logo__icon site-logo__icon--dark"
            src={logoSmDark}
            alt=""
            width={64}
            densities={[1, 2, 3]}
          />
        </span>
        <span class="site-logo__words">
          <span lang="ar" dir="rtl">
            نادي الحاسب الآلي
          </span>
          <b>Computer Club</b>
        </span>
      </a>
      <NextEvent variant="bar" />
    </div>

    <div class="site-header__end">
      <nav id="site-nav" class="site-nav" aria-label="Main">
        <NextEvent variant="menu" />
        {links.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))}
        <a
          class="btn btn--small"
          data-magnet
          href={joinHref}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener' : undefined}
          data-join
        >
          Join <span aria-hidden="true">→</span>
        </a>
      </nav>
      <div class="site-header__tools">
        <button type="button" class="term-open" data-term-open aria-label="Open terminal" title="Terminal">
          &gt;_
        </button>
        <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu">
          Menu
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  import '../scripts/header.js';
  import '../scripts/account.js';
</script>
