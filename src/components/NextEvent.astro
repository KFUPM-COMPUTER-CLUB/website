---
/* "Next: <event> in 3d 4h" pill for the header. Upcoming events come from the content layer; the
   script picks the first one that has not ended and counts down to it. Nothing renders when there
   is no upcoming event. */
import { getUpcomingEvents, eventEnd } from '../lib/content';
const { variant = 'bar' } = Astro.props;
const list = (await getUpcomingEvents())
  .slice(0, 5)
  .map((e) => ({ id: e.slug, t: e.title, s: e.start.getTime(), e: eventEnd(e).getTime() }));

import { t, localePath, type Lang } from '../lib/i18n';
const lang = (Astro.currentLocale ?? 'en') as Lang;
---

{list.length > 0 && (
  <a class={`next-pill next-pill--${variant}`} data-next={JSON.stringify(list)} hidden href="/timeline">
    <i class="next-pill__dot" aria-hidden="true"></i>
    <span class="next-pill__label">Next:</span>
    <span class="next-pill__title"></span>
    <span class="next-pill__when"></span>
  </a>
)}

<script>
  import '../scripts/next-event.js';
</script>
