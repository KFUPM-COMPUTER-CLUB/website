---
// Infinite horizontal strip of event photos. Every thumbnail is rendered small and lazy;
// a script picks a random 20 on each load (mixed years), duplicates them for a seamless loop,
// pauses on hover, and stays static under prefers-reduced-motion.
// The pool comes from the strip_photos table (or every seed photo in src/data/photos).
import { getStripPhotos } from '../lib/content';
const items = (await getStripPhotos())
  .map((p) => ({ ...p, year: p.date.slice(0, 4) }))
  .sort((a, b) => a.date.localeCompare(b.date));
const fmt = (d: string) =>
  d
    ? new Date(d + 'T00:00:00Z').toLocaleDateString(Astro.currentLocale === 'ar' ? 'ar-SA-u-ca-gregory' : 'en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      })
    : '';
import { t, type Lang } from '../lib/i18n';
const lang = (Astro.currentLocale ?? 'en') as Lang;
---

<div class="strip" data-strip>
  <ul class="strip__track">
    {items.map((p) => (
      <li class="strip__item" data-year={p.year} hidden>
        <a href={p.postUrl || '#'} target="_blank" rel="noopener">
          <img
            src={p.img!.src}
            srcset={p.img!.srcset}
            sizes="360px"
            alt={`${t(lang, 'photo.eventAlt')}, ${fmt(p.date)}`}
            width="360"
            height="240"
            loading="lazy"
            decoding="async"
          />
          <span class="strip__cap">
            <b>{p.label}</b>
            <span>{fmt(p.date)}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  import '../scripts/photo-strip.js';
</script>
