---
/* "This month" on the home page (#115, design A): the featured post of the month beside the top three
 * members of the term, with links to /blog and /leaderboard. Members who did not opt in keep their place
 * as "A member", as on /leaderboard. Either half takes the full width when the other is missing; the
 * section hides when both are. */
import type { LeaderRow, PostSummary } from '../lib/types';
import { fmtRiyadh, termOf } from '../lib/content';
import { t, dateLocale, localePath, localizeTerm, type Lang } from '../lib/i18n';
const { post, leaders } = Astro.props as { post: PostSummary | null; leaders: LeaderRow[] };
const lang = (Astro.currentLocale ?? 'en') as Lang;
const locale = dateLocale(lang);
const top = leaders.slice(0, 3);
const both = !!post && top.length > 0;
---

{
  (post || top.length > 0) && (
    <section class="section highlights bg-black" data-bg="#0B0B0F">
      <div class={`container highlights__grid${both ? '' : ' highlights__grid--one'}`}>
        {post && (
          <article class="highlight-post reveal" dir={post.dir}>
            <span class="eyebrow">{t(lang, 'blog.featuredOfMonth')}</span>
            <h2 class="highlight-post__title">
              <a href={localePath(lang, `/blog/${post.slug}`)}>{post.title}</a>
            </h2>
            <p class="post__author">
              {post.authorName}
              {post.category && ` · ${post.category}`} ·{' '}
              {fmtRiyadh(post.date, { day: 'numeric', month: 'short', year: 'numeric' }, locale)}
            </p>
            {post.excerpt && <p class="highlight-post__excerpt">{post.excerpt}</p>}
            <div class="highlight-post__actions">
              <a class="btn" href={localePath(lang, `/blog/${post.slug}`)}>
                {t(lang, 'home.readPost')} <span aria-hidden="true">→</span>
              </a>
              <a class="link-arrow" href={localePath(lang, '/blog')}>
                {t(lang, 'blog.allPosts')} →
              </a>
            </div>
          </article>
        )}
        {top.length > 0 && (
          <div class="highlight-top reveal">
            <span class="eyebrow">
              {t(lang, 'home.topMembers')} · {localizeTerm(lang, termOf(new Date()))}
            </span>
            <ol class="leaders">
              {top.map((r) => (
                <li class={r.handle ? 'leader' : 'leader leader--anon'}>
                  <span class="leader__rank">{r.rank}</span>
                  {r.avatar ? (
                    <img class="leader__photo" src={r.avatar} alt="" width="44" height="44" loading="lazy" />
                  ) : (
                    <span class="leader__photo leader__photo--blank" aria-hidden="true">
                      {r.handle ? (r.name || '?').slice(0, 1) : '·'}
                    </span>
                  )}
                  <span class="leader__name">
                    {r.handle ? (
                      <a href={localePath(lang, `/u/${r.handle}`)}>{r.name || `@${r.handle}`}</a>
                    ) : (
                      t(lang, 'leaderboard.member')
                    )}
                  </span>
                  <span class="leader__total">
                    <b>{r.total}</b> {t(lang, 'leaderboard.points')}
                  </span>
                </li>
              ))}
            </ol>
            <a class="link-arrow" href={localePath(lang, '/leaderboard')}>
              {t(lang, 'home.fullBoard')} →
            </a>
          </div>
        )}
      </div>
    </section>
  )
}
