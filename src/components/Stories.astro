---
// Three moments: one photo each with a short record of what happened. Advances on its own every
// few seconds, pauses on hover, and can be stepped with the dots or arrows. Static under
// prefers-reduced-motion. Content comes from the stories table (or src/data/stories.json as seed).
import { getStories } from '../lib/content';
const stories = await getStories();
const locale = Astro.currentLocale === 'ar' ? 'ar-SA-u-ca-gregory' : 'en-GB';
const fmt = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString(locale, {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
import { t, type Lang } from '../lib/i18n';
const lang = (Astro.currentLocale ?? 'en') as Lang;
---

<section
  class="stories bg-black"
  data-bg="#0B0B0F"
  data-stories
  aria-roledescription="carousel"
  aria-label={t(lang, 'stories.label')}
>
  {stories.map((s, i) => (
    <article class="story" data-slide={i} data-active={i === 0 ? '' : undefined} aria-hidden={i !== 0}>
      <img
        class="story__photo"
        src={s.img!.src}
        srcset={s.img!.srcset}
        sizes="100vw"
        alt=""
        width="1800"
        height="1000"
        loading={i === 0 ? 'eager' : 'lazy'}
        decoding="async"
      />
      <div class="story__card">
        <span class="eyebrow">{fmt(s.date)}</span>
        <h3 class="h2">{s.title}</h3>
        <p>{s.text}</p>
        {s.postUrl && (
          <a class="link-arrow" href={s.postUrl} target="_blank" rel="noopener">
            {t(lang, 'stories.open')} ↗
          </a>
        )}
      </div>
    </article>
  ))}
  <div class="story__nav">
    <button type="button" class="story__arrow" data-dir="-1" aria-label={t(lang, 'stories.previous')}>
      ‹
    </button>
    <span class="story__dots">
      {stories.map((_, i) => (
        <button
          type="button"
          data-go={i}
          aria-label={`${t(lang, 'stories.slide')} ${i + 1}`}
          data-active={i === 0 ? '' : undefined}
        ></button>
      ))}
    </span>
    <button type="button" class="story__arrow" data-dir="1" aria-label={t(lang, 'stories.next')}>
      ›
    </button>
  </div>
</section>

<script>
  import '../scripts/stories.js';
</script>
