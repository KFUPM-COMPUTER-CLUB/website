---
// Three moments: one photo each with a short record of what happened. Advances on its own every
// few seconds, pauses on hover, and can be stepped with the dots or arrows. Static under
// prefers-reduced-motion. Content comes from the stories table (or src/data/stories.json as seed).
import { getStories } from '../lib/content';
const stories = await getStories();
const fmt = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<section
  class="stories bg-black"
  data-bg="#0B0B0F"
  data-stories
  aria-roledescription="carousel"
  aria-label="Moments from the club"
>
  {stories.map((s, i) => (
    <article class="story" data-slide={i} data-active={i === 0 ? '' : undefined} aria-hidden={i !== 0}>
      <img
        class="story__photo"
        src={s.img!.src}
        srcset={s.img!.srcset}
        sizes="100vw"
        alt=""
        width="1800"
        height="1000"
        loading={i === 0 ? 'eager' : 'lazy'}
        decoding="async"
      />
      <div class="story__card">
        <span class="eyebrow">{fmt(s.date)}</span>
        <h3 class="h2">{s.title}</h3>
        <p>{s.text}</p>
        {s.postUrl && (
          <a class="link-arrow" href={s.postUrl} target="_blank" rel="noopener">
            Open the post ↗
          </a>
        )}
      </div>
    </article>
  ))}
  <div class="story__nav">
    <button type="button" class="story__arrow" data-dir="-1" aria-label="Previous">
      ‹
    </button>
    <span class="story__dots">
      {stories.map((_, i) => (
        <button type="button" data-go={i} aria-label={`Slide ${i + 1}`} data-active={i === 0 ? '' : undefined}></button>
      ))}
    </span>
    <button type="button" class="story__arrow" data-dir="1" aria-label="Next">
      ›
    </button>
  </div>
</section>

<script>
  import '../scripts/stories.js';
</script>
