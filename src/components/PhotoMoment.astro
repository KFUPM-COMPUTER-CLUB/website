---
// One huge darkened photo with a single line over it.
import { Image } from 'astro:assets';
const all = import.meta.glob('../assets/photos/*.jpg', { eager: true });
const { photo, line, eyebrow } = Astro.props;
---

<section class="moment bg-black" data-bg="#0B0B0F">
  <Image class="moment__photo" src={all[`../assets/photos/${photo}`].default} alt="" width={1800} height={1000} loading="lazy" />
  <div class="moment__text">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <p class="h1">{line}</p>
  </div>
</section>
