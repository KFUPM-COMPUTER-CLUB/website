---
/* Side navigation for the dashboard and the admin panel. Root items (/me, /admin) match their exact
 * path only, so Overview and Dashboard do not light up on every subpage. */
const { items } = Astro.props as { items: { href: string; label: string }[] };
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const current = (href: string) =>
  path === href ||
  (href !== '/me' && href !== '/admin' && path.startsWith(`${href}/`)) ||
  (href !== '/me' && href !== '/admin' && path === href);
import { t, localePath, type Lang } from '../lib/i18n';
const lang = (Astro.currentLocale ?? 'en') as Lang;
---

<nav class="subnav" aria-label="Section">
  {items.map((i) => (
    <a href={i.href} aria-current={current(i.href) ? 'page' : undefined}>
      {i.label}
    </a>
  ))}
</nav>
