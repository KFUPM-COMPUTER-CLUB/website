---
// Tilted polaroids of club moments, straddling the seam between screens. Every card links to the
// original post. Content comes from the highlights table (or src/data/highlights.json as seed).
import { getHighlights } from '../lib/content';
const items = await getHighlights();
const fmt = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString(dateLocale(Astro.currentLocale), {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
// Photos that also appear on the timeline morph into place there; names must be unique per page.
const seen = new Set<string>();
const morph = (key: string | null) => {
  if (!key) return undefined;
  const n = `photo-${key.replace(/\.[a-z]+$/i, '')}`;
  if (seen.has(n)) return undefined;
  seen.add(n);
  return n;
};
import { t, dateLocale, type Lang } from '../lib/i18n';
const lang = (Astro.currentLocale ?? 'en') as Lang;
---

<div class="collage" aria-label={t(lang, 'collage.label')}>
  {items.map((h, i) => (
    <a
      class={`polaroid polaroid--${i + 1}`}
      href={h.postUrl || '#'}
      target="_blank"
      rel="noopener"
      transition:name={morph(h.photoKey)}
    >
      <img
        class="polaroid__photo"
        src={h.img!.src}
        srcset={h.img!.srcset}
        sizes="(min-width: 1024px) 300px, 90vw"
        alt={h.title}
        width="640"
        height="480"
        loading={i < 3 ? 'eager' : 'lazy'}
        decoding="async"
      />
      <div class="polaroid__cap">
        <span>{fmt(h.date)}</span>
        <b>{h.title}</b>
      </div>
      <div class="polaroid__card" aria-hidden="true">
        <span class="mono">{fmt(h.date)}</span>
        <strong>{h.title}</strong>
        <p>{h.line}</p>
        <em>{t(lang, 'collage.open')} ↗</em>
      </div>
    </a>
  ))}
</div>
