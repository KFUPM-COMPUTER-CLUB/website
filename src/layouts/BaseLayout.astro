---
/* The shell every page uses: head tags, fonts, header, banner, footer, the terminal and the global
 * scripts. ClientRouter enables view transitions, which is why every client script goes through
 * onPage() in scripts/page.js instead of running at module load. Settings come from the content
 * layer (memoised), so this layout is cheap on cached pages. The HTML comment near the end of body
 * is clue 2 of the site challenge; keep it. */
import '../styles/global.css';
import '../styles/terminal.css';
import '../styles/magnetic.css';
import '../styles/drag.css';
import '../styles/next-event.css';
import '../styles/progress.css';
import '../styles/copy.css';
import Terminal from '../components/Terminal.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '../lib/content';
const settings = await getSettings();
const site = settings.site;
import { ClientRouter } from 'astro:transitions';

// Every page passes a title; the description falls back to the club's.
// noindex keeps a page out of search results (dashboards, admin, the style guide).
const { title, description = site.description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} · ${site.name}`}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B0B0F" />
    <meta name="site-root" content="/" />
    <ClientRouter fallback="animate" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Mona+Sans:wdth,wght@75..125,200..900&family=Hubot+Sans:wght@300..700&family=JetBrains+Mono:wght@400..700&family=Readex+Pro:wght@300..600&display=swap"
    />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true">
      <i></i>
    </div>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    {settings.banner && (
      <div class="banner" role="status">
        <div class="container">
          {settings.banner.url ? <a href={settings.banner.url}>{settings.banner.text}</a> : settings.banner.text}
        </div>
      </div>
    )}
    <main id="main" class="site-main bg-black" data-bg="#0B0B0F">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/theme.js';
      import '../scripts/cursor.js';
      import '../scripts/decode.js';
      import '../scripts/magnetic.js';
      import '../scripts/drag.js';
      import '../scripts/progress.js';
      import '../scripts/copy.js';
    </script>
    <Terminal />
    <!-- clue 2/3: the terminal remembers files it does not show. Press ` and ask ls the way you would ask for hidden ones. -->
  </body>
</html>
