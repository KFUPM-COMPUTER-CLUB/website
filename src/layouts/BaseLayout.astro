---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
        <link href="https://fonts.googleapis.com/css2?family=Mona+Sans:wght@300..700&family=Hubot+Sans:wght@400..700&family=Readex+Pro:wght@300..600&display=swap" rel="stylesheet" />
		<meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <title>{title} · KFUPM Computer Club</title>
    </head>
	<body>

        <Header />
        <main id="main">
            <!-- Main content -->
             <slot>

             </slot>
        </main>
        <Footer />
	</body>
</html>
