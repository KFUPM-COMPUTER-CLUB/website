---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyEmail from '../components/CopyEmail.astro';
import BackToTop from '../components/BackToTop.astro';
import { getFaq, getSettings } from '../lib/content';
import { t, type Lang } from '../lib/i18n';
const lang = (Astro.currentLocale ?? 'en') as Lang;
const [faq, settings] = await Promise.all([getFaq(), getSettings()]);
const email = settings.site.email;
const items = faq.map((f) => {
  if (lang === 'ar' && f.qAr && f.aAr) return { q: f.qAr, a: f.aAr, lang: 'ar' };
  return { q: f.q, a: f.a, lang: 'en' };
});
---

<BaseLayout title={t(lang, 'faq.pageTitle')} description={t(lang, 'faq.description')}>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">{t(lang, 'faq.eyebrow')}</span>
      <h1 class="h-display">{t(lang, 'faq.title')}</h1>
      <p class="lead">{t(lang, 'faq.lead')}</p>
    </div>
  </section>
  <section class="section">
    <div class="container" style="max-width:860px">
      <div class="faq reveal">
        {items.map((f, i) => (
          <details open={i === 0}>
            <summary>
              <span lang={f.lang} dir="auto">
                {f.q}
              </span>
            </summary>
            <div class="faq__a">
              <p lang={f.lang} dir="auto">
                {f.a}
              </p>
            </div>
          </details>
        ))}
      </div>
      <div class="hero__actions" style="margin-top:40px">
        <a class="btn" href="/join">
          {t(lang, 'faq.join')} <span aria-hidden="true">→</span>
        </a>
        {email && (
          <a class="btn btn--ghost" href={`mailto:${email}`}>
            {t(lang, 'faq.email')}
          </a>
        )}
        {email && <CopyEmail email={email} label={t(lang, 'footer.clubEmail')} />}
      </div>
    </div>
  </section>
  <BackToTop slot="floating" />
</BaseLayout>
