---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyEmail from '../components/CopyEmail.astro';
import BackToTop from '../components/BackToTop.astro';
import { getFaq, getSettings } from '../lib/content';
const [faq, settings] = await Promise.all([getFaq(), getSettings()]);
const email = settings.site.email;
const hasArabic = faq.some((f) => f.qAr && f.aAr);
---

<BaseLayout title="Questions" description="Common questions about joining and taking part in the KFUPM Computer Club.">
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Frequently asked questions</span>
      <h1 class="h-display">Questions people ask us.</h1>
      <p class="lead">Short answers. If yours is not here, ask on X or at any event.</p>
      {hasArabic && (
        <p class="faq__lang">
          <button type="button" class="btn btn--ghost btn--small" data-faq-lang="en" aria-pressed="true">
            English
          </button>{' '}
          <button type="button" class="btn btn--ghost btn--small" data-faq-lang="ar" aria-pressed="false">
            العربية
          </button>
        </p>
      )}
    </div>
  </section>
  <section class="section">
    <div class="container" style="max-width:860px">
      <div class="faq reveal" data-faq>
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>
              <span data-lang="en">{f.q}</span>
              {f.qAr && (
                <span data-lang="ar" lang="ar" dir="rtl" hidden>
                  {f.qAr}
                </span>
              )}
            </summary>
            <div class="faq__a">
              <p data-lang="en">{f.a}</p>
              {f.aAr && (
                <p data-lang="ar" lang="ar" dir="rtl" hidden>
                  {f.aAr}
                </p>
              )}
            </div>
          </details>
        ))}
      </div>
      <div class="hero__actions" style="margin-top:40px">
        <a class="btn" href="/join">
          Join the club <span aria-hidden="true">→</span>
        </a>
        {email && (
          <a class="btn btn--ghost" href={`mailto:${email}`}>
            Email us
          </a>
        )}
        {email && <CopyEmail email={email} label="Club email" />}
      </div>
    </div>
  </section>
  <BackToTop slot="floating" />
</BaseLayout>

<script>
  import '../scripts/faq.js';
</script>
