---
/* Privacy: what the site stores about members, why, who sees it, and how to leave. English then Arabic. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSettings } from '../lib/content';
const s = await getSettings();
const contact = s.site.email ? `the club email, ${s.site.email}` : 'the club on X, @KFUPM_CC';
const contactAr = s.site.email ? `بريد النادي ${s.site.email}` : 'حساب النادي على X: @KFUPM_CC';
---

<BaseLayout
  title="Privacy"
  description="What the KFUPM Computer Club site stores about members, why, who can see it, and how to delete it."
>
  <section class="page-head page-head--compact">
    <div class="container">
      <span class="eyebrow">Privacy</span>
      <h1 class="h1">What we keep, and why.</h1>
      <p class="lead">
        Short and plain. <a href="#ar">النسخة العربية</a>
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container prose" style="max-width:760px">
      <h2>What we collect</h2>
      <p>
        When you join, you give us your name, email, phone number, major and year, and you pick a public handle.
        Optionally: your KFUPM email, GitHub, LinkedIn, a short bio and a photo. Signing in with GitHub or Google also
        gives us the name, email and avatar on that account.
      </p>
      <p>
        Using the site adds: posts you write (drafts and published), events you reserve a spot for and whether you
        attended, and files you upload (images and PDFs).
      </p>
      <h2>Why</h2>
      <p>
        Name, major and year tell us who our members are. Email is how we reach you: a welcome message with the group
        links, a note when a post you wrote changes status, a copy of a reservation only if you ask for one, and a
        weekly digest of upcoming events and new posts only if you turn it on in your profile (every digest has an
        unsubscribe link). Phone number is for event logistics and reaching you when something is urgent. We send no
        marketing.
      </p>
      <h2>Who can see it</h2>
      <ul>
        <li>
          <strong>Everyone:</strong> your handle, name, bio, photo, major, year, GitHub and LinkedIn links, published
          posts, the events you chose to show on your profile, and your badges if you choose to show them in your
          profile settings. If you place in a competition, the timeline and your profile show your place, your name or
          team name, and the prize in SAR.
        </li>
        <li>
          <strong>Members only:</strong> the WhatsApp and other group invite links.
        </li>
        <li>
          <strong>Admins only:</strong> your email and phone number. Officers running an event see the names of people
          who reserved a spot; only admins see their contact details.
        </li>
      </ul>
      <p>
        Your data is stored with Supabase and the site runs on Vercel, both in the Stockholm (EU) region. We do not sell
        or share it with anyone else. The site sets only the cookies it needs to keep you signed in; there are no
        analytics or tracking cookies.
      </p>
      <h2>Your choices</h2>
      <p>
        You can edit everything under <a href="/me/profile">your profile</a>, decide whether you appear among top
        contributors, and show or hide each event on your public profile.
      </p>
      <h2>Deleting your account</h2>
      <p>
        Open <a href="/me/profile">your profile</a>, type "delete" under Delete my account, and confirm. This removes
        your profile, your posts (including published ones), your reservations and your uploads, immediately and
        permanently. If you cannot sign in, write to {contact} from the email you joined with.
      </p>
      <h2>Contact</h2>
      <p>Questions about your data: {contact}.</p>
      <p class="mono">Last updated: October 2026</p>

      <hr />
      <div id="ar" lang="ar" dir="rtl" style="font-family: var(--font-ar)">
        <h2>ما الذي نجمعه</h2>
        <p>
          عند الانضمام تعطينا اسمك وبريدك الإلكتروني ورقم هاتفك وتخصصك وسنتك الدراسية، وتختار اسم مستخدم عامًا.
          اختياريًا: بريد الجامعة، وحسابا GitHub وLinkedIn، ونبذة قصيرة، وصورة. تسجيل الدخول عبر GitHub أو Google
          يزوّدنا أيضًا بالاسم والبريد والصورة في ذلك الحساب.
        </p>
        <p>
          استخدام الموقع يضيف: المقالات التي تكتبها (المسودات والمنشورة)، والفعاليات التي حجزت فيها مقعدًا وهل حضرتها،
          والملفات التي ترفعها (صور وملفات PDF).
        </p>
        <h2>لماذا</h2>
        <p>
          الاسم والتخصص والسنة تعرّفنا بأعضائنا. البريد الإلكتروني هو وسيلتنا للتواصل معك: رسالة ترحيب تحوي روابط
          المجموعات، وإشعار عند تغيّر حالة مقال كتبته، ونسخة من الحجز فقط إذا طلبتها، وملخص أسبوعي بالفعاليات القادمة
          والمقالات الجديدة فقط إذا فعّلته من ملفك الشخصي (وفي كل ملخص رابط لإلغاء الاشتراك). رقم الهاتف لترتيبات
          الفعاليات وللتواصل العاجل. لا نرسل رسائل تسويقية.
        </p>
        <h2>من يرى بياناتك</h2>
        <ul>
          <li>
            <strong>الجميع:</strong> اسم المستخدم، الاسم، النبذة، الصورة، التخصص، السنة، روابط GitHub وLinkedIn،
            المقالات المنشورة، والفعاليات التي اخترت إظهارها في ملفك، وأوسمتك إذا اخترت إظهارها من إعدادات ملفك. وإذا
            حصلت على مركز في مسابقة، يُعرض مركزك واسمك أو اسم فريقك وقيمة الجائزة بالريال في صفحة Timeline وفي ملفك.
          </li>
          <li>
            <strong>الأعضاء فقط:</strong> روابط مجموعات واتساب وغيرها من روابط الدعوة.
          </li>
          <li>
            <strong>المشرفون فقط:</strong> بريدك الإلكتروني ورقم هاتفك. مسؤولو الفعالية يرون أسماء من حجزوا مقعدًا؛
            والمشرفون وحدهم يرون بيانات التواصل.
          </li>
        </ul>
        <p>
          تُخزَّن بياناتك لدى Supabase ويعمل الموقع على Vercel، وكلاهما في منطقة ستوكهولم (الاتحاد الأوروبي). لا نبيع
          بياناتك ولا نشاركها مع أي جهة أخرى. لا يستخدم الموقع إلا ملفات تعريف الارتباط اللازمة لإبقائك مسجّل الدخول؛ لا
          توجد أدوات تحليل أو تتبّع.
        </p>
        <h2>خياراتك</h2>
        <p>
          يمكنك تعديل كل شيء من <a href="/me/profile">ملفك الشخصي</a>، وتحديد ما إذا كنت تظهر ضمن أبرز الكتّاب، وإظهار
          أو إخفاء كل فعالية في ملفك العام.
        </p>
        <h2>حذف حسابك</h2>
        <p>
          افتح <a href="/me/profile">ملفك الشخصي</a>، واكتب "delete" تحت «حذف حسابي»، ثم أكّد. يحذف ذلك ملفك ومقالاتك
          (بما فيها المنشورة) وحجوزاتك وملفاتك فورًا ونهائيًا. إذا تعذّر عليك تسجيل الدخول، راسل {contactAr} من البريد
          الذي انضممت به.
        </p>
        <h2>التواصل</h2>
        <p>للأسئلة حول بياناتك: {contactAr}.</p>
        <p class="mono">آخر تحديث: أكتوبر 2026</p>
      </div>
    </div>
  </section>
</BaseLayout>
