---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/snake.css';

// Astro serves this page for any unknown path. It keeps the site chrome and hands the visitor a
// game of Snake while they are here. The game script runs only on pages with [data-snake].
---

<BaseLayout title="404" description="That page does not exist. Play a round of Snake, then head home." noindex={true}>
  <section class="section snake" data-snake>
    <div class="container">
      <span class="mono">Error 404</span>
      <h1 class="h1 snake__title">404: segfault in the matrix</h1>
      <p class="lead snake__lead">That page was never allocated. While you are here, the snake is.</p>

      <div class="snake__game">
        <div class="snake__meta">
          <span class="mono">
            Score <b data-snake-score>0</b>
          </span>
          <span class="mono">
            Best <b data-snake-best>0</b>
          </span>
        </div>

        <div
          class="snake__board"
          tabindex="0"
          role="application"
          aria-label="Snake. Arrow keys or W A S D to steer, Space to start or pause, swipe on touch screens."
          data-snake-board
        >
          <canvas class="snake__canvas" width="400" height="400" data-snake-canvas>
            Snake needs a browser with canvas support.
          </canvas>
        </div>

        <div class="snake__pad" aria-label="Steer">
          <button class="btn btn--ghost" type="button" data-dir="up" aria-label="Up">
            ↑
          </button>
          <button class="btn btn--ghost" type="button" data-dir="left" aria-label="Left">
            ←
          </button>
          <button class="btn btn--ghost" type="button" data-dir="down" aria-label="Down">
            ↓
          </button>
          <button class="btn btn--ghost" type="button" data-dir="right" aria-label="Right">
            →
          </button>
        </div>

        <p class="visually-hidden" aria-live="polite" data-snake-status></p>
      </div>

      <div class="snake__actions">
        <a class="btn" href="/">
          Take me home
        </a>
        <a class="btn btn--ghost" href="/timeline">
          See the timeline
        </a>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/snake.js';
  </script>
</BaseLayout>
