---
/* Public member profile at /u/<handle>. Cached like every public page, so it reads with the anon
 * client and row level security does the filtering: profiles_public has no phone or email,
 * profile_events() returns only the events the member chose to show, and only approved flag solvers
 * are visible. The handle is lowercased before the lookup, which is why handles are stored lowercase. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import logoSmDark from '../../data/brand/logo-color-ondark-sm.png';
import { dbReady } from '../../lib/env';
import { publicClient } from '../../lib/supabase';
import { getSettings, fmtRiyadh } from '../../lib/content';
import { t, localePath, type Lang } from '../../lib/i18n';
const handle = (Astro.params.handle || '').toLowerCase();
if (!dbReady() || !/^[a-z0-9_]{3,24}$/.test(handle)) return new Response(null, { status: 404 });
const locale = Astro.currentLocale === 'ar' ? 'ar-SA-u-ca-gregory' : 'en-GB';
const lang = (Astro.currentLocale ?? 'en') as Lang;
const db = publicClient();
const { data: p } = await db.from('profiles_public').select('*').eq('handle', handle).maybeSingle();
if (!p) return new Response(null, { status: 404 });
const [
  { data: posts },
  { data: regs },
  { data: officer },
  { data: solved },
  settings,
  { data: committee },
  { data: points },
] = await Promise.all([
  db
    .from('posts')
    .select('slug,title,excerpt,published_at,category')
    .eq('author_id', p.id)
    .eq('status', 'published')
    .order('published_at', { ascending: false }),
  db.rpc('profile_events', { p_user: p.id }),
  db
    .from('officer_terms')
    .select('title,committee,term,is_current')
    .eq('user_id', p.id)
    .order('is_current', { ascending: false })
    .limit(3),
  db.from('flag_solvers').select('id').eq('user_id', p.id).eq('approved', true).limit(1),
  getSettings(),
  // committee_id is on profiles_public from 0003_committee_members.sql; before that it is undefined.
  p.committee_id
    ? db.from('committees').select('name').eq('id', p.committee_id).maybeSingle()
    : Promise.resolve({ data: null as { name: string } | null }),
  // Points show only for members who opted in on their profile (show_on_leaderboard, 0006_leaderboard.sql).
  p.show_on_leaderboard ? db.rpc('member_points', { p_user: p.id }) : Promise.resolve({ data: null as number | null }),
]);
const current = (officer || []).find((o: any) => o.is_current);
const badges = [
  current && `${t(lang, 'profile.officer')} · ${current.title}`,
  committee?.name && `${committee.name} ${t(lang, 'profile.committee')}`,
  (officer || []).some((o: any) => !o.is_current) && t(lang, 'profile.pastOfficer'),
  (posts?.length || 0) > 0 && t(lang, 'profile.writer'),
  (regs || []).some((r: any) => r.attended) && t(lang, 'profile.attendedEvents'),
  solved?.length && t(lang, 'profile.flagSolver'),
  `${t(lang, 'profile.memberSince')} ${String(p.created_at).slice(0, 4)}`,
].filter(Boolean) as string[];
// The counts beside the photo; each links down to its list when there is one (an <a> without href is inert).
const stats = [
  {
    count: posts?.length || 0,
    label: posts?.length === 1 ? t(lang, 'profile.post') : t(lang, 'profile.posts'),
    href: '#posts',
  },
  {
    count: regs?.length || 0,
    label: regs?.length === 1 ? t(lang, 'profile.event') : t(lang, 'profile.events'),
    href: '#events',
  },
  ...(typeof points === 'number'
    ? [
        {
          count: points,
          label: points === 1 ? t(lang, 'profile.point') : t(lang, 'profile.points'),
          href: localePath(lang, '/leaderboard/all-time'),
        },
      ]
    : []),
];
---

<BaseLayout title={p.name || p.handle} description={p.bio || `${p.name} at the KFUPM Computer Club.`}>
  <section class="page-head page-head--compact">
    <div class="container profile__head profile__head--top">
      {p.avatar_url ? (
        <img class="avatar avatar--lg" src={p.avatar_url} alt="" />
      ) : (
        <span class="avatar avatar--lg person__blank" aria-hidden="true">
          {(p.name || '?').slice(0, 1)}
        </span>
      )}
      <div class="profile__info">
        <span class="eyebrow">@{p.handle}</span>
        <h1 class="h1" style="margin:0">
          {p.name}
        </h1>
        {(p.major || p.year) && (
          <p class="mono" style="margin:8px 0 0">
            {[p.major, p.year].filter(Boolean).join(' · ')}
          </p>
        )}
        <ul class="profile__stats">
          {stats.map((s) => (
            <li>
              <a href={s.count ? s.href : undefined}>
                <b>{s.count}</b> {s.label}
              </a>
            </li>
          ))}
        </ul>
        {p.bio && <p class="profile__bio">{p.bio}</p>}
        {(p.github || p.linkedin) && (
          <p class="links-row profile__links">
            {p.github && (
              <a class="link-arrow" href={`https://github.com/${p.github}`} target="_blank" rel="noopener">
                GitHub ↗
              </a>
            )}
            {p.linkedin && (
              <a class="link-arrow" href={p.linkedin} target="_blank" rel="noopener">
                LinkedIn ↗
              </a>
            )}
          </p>
        )}
        <ul class="badges">
          {badges.map((b) => (
            <li class="chip">{b}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {current && (
        <article class="idcard" style="max-width:420px;margin:32px 0">
          <div class="idcard__top">
            <span class="idcard__brand">
              <Image src={logoSmDark} alt="" width={32} densities={[1, 2, 3]} /> {settings.site.name}
            </span>
            <span class="mono">
              {t(lang, 'profile.idOfficer')} · {current.term}
            </span>
          </div>
          <div class="idcard__body">
            <div class="idcard__info">
              <h2>{p.name}</h2>
              <p class="idcard__role">{current.title}</p>
              <dl>
                {current.committee && (
                  <div>
                    <dt>{t(lang, 'community.committee')}</dt>
                    <dd>{current.committee}</dd>
                  </div>
                )}
                {p.major && (
                  <div>
                    <dt>{t(lang, 'profile.major')}</dt>
                    <dd>{p.major}</dd>
                  </div>
                )}
              </dl>
            </div>
          </div>
          <div class="idcard__strip">
            <span class="idcard__barcode" aria-hidden="true"></span>
            <span class="mono">cckfupm.com</span>
          </div>
        </article>
      )}
      {posts?.length ? (
        <>
          <h2 class="h2" id="posts" style="margin-top:40px">
            {t(lang, 'profile.postsHeading')}
          </h2>
          <div class="posts">
            {posts.map((x: any) => (
              <a class="post" href={localePath(lang, `/blog/${x.slug}`)}>
                <time class="post__date" datetime={String(x.published_at).slice(0, 10)}>
                  <b>{fmtRiyadh(new Date(x.published_at), { month: 'short' }, locale)}</b>
                  <span>{fmtRiyadh(new Date(x.published_at), { day: 'numeric', year: 'numeric' }, locale)}</span>
                </time>
                <div class="post__body">
                  <h3 class="post__title">{x.title}</h3>
                  <p class="post__excerpt">{x.excerpt}</p>
                </div>
              </a>
            ))}
          </div>
        </>
      ) : null}
      {regs?.length ? (
        <>
          <h2 class="h2" id="events" style="margin-top:40px">
            {t(lang, 'profile.eventsHeading')}
          </h2>
          <ul>
            {regs.map((r: any) => (
              <li>
                <a href={`${localePath(lang, '/timeline')}#ev-${r.slug}`}>{r.title}</a> ·{' '}
                <span class="mono">
                  {fmtRiyadh(new Date(r.starts_at), { day: 'numeric', month: 'short', year: 'numeric' }, locale)}
                </span>{' '}
                {r.attended ? (
                  <span class="chip chip--published">{t(lang, 'profile.attended')}</span>
                ) : (
                  <span class="chip">{t(lang, 'profile.registered')}</span>
                )}
              </li>
            ))}
          </ul>
        </>
      ) : null}
    </div>
  </section>
</BaseLayout>
