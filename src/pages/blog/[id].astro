---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackToTop from '../../components/BackToTop.astro';
import { render } from 'astro:content';
import { getPost, fmtRiyadh, riyadhDate } from '../../lib/content';
const post = await getPost(Astro.params.id || '');
if (!post) return new Response(null, { status: 404 });
const Content = post.entry ? (await render(post.entry)).Content : null;
const short = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
// "Updated" only for an edit more than a day after publishing, so fixing a typo right away does not count.
const updated = post.updatedAt && post.updatedAt.getTime() - post.date.getTime() > 86_400_000 ? post.updatedAt : null;
---

<BaseLayout title={post.title} description={post.excerpt} type="article">
  <section class="page-head">
    <div class="container" dir={post.dir}>
      <h1 class="h1">{post.title}</h1>
      <p class="meta" style="margin-top:18px">
        <span>
          By {post.authorHandle ? <a href={`/u/${post.authorHandle}`}>{post.authorName}</a> : post.authorName}
        </span>
        <time datetime={post.date.toISOString().slice(0, 10)}>{short(post.date)}</time>
        {post.category && <span>{post.category}</span>}
      </p>
      {updated && (
        <p class="meta" style="margin-top:8px">
          <span>
            Updated{' '}
            <time datetime={riyadhDate(updated)}>
              {fmtRiyadh(updated, { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
          </span>
        </p>
      )}
    </div>
  </section>
  <section class="section">
    <div class="container">
      <article class="prose" dir={post.dir} data-prose>
        {Content ? <Content /> : <Fragment set:html={post.html || ''} />}
      </article>
      {post.tags.length > 0 && (
        <p class="tags">
          {post.tags.map((t) => (
            <a class="tag" href={`/blog?tag=${encodeURIComponent(t)}`}>
              #{t}
            </a>
          ))}
        </p>
      )}
      <aside class="author-card">
        {post.authorAvatar ? (
          <img src={post.authorAvatar} alt="" width="56" height="56" loading="lazy" />
        ) : (
          <span class="author-card__blank" aria-hidden="true">
            {post.authorName.slice(0, 1)}
          </span>
        )}
        <div>
          <span class="mono">Written by</span>
          <b>{post.authorHandle ? <a href={`/u/${post.authorHandle}`}>{post.authorName}</a> : post.authorName}</b>
          {post.authorHandle && (
            <a class="link-arrow" href={`/u/${post.authorHandle}`}>
              Profile →
            </a>
          )}
        </div>
      </aside>
      <p style="margin-top:32px">
        <a class="link-arrow" href="/blog">
          ← All posts
        </a>
      </p>
    </div>
  </section>
  <BackToTop slot="floating" />
</BaseLayout>

<script>
  import '../../scripts/highlight.js';
</script>
