---
/* The blog: the featured post of the month in a hero card, then every post, with the writers'
 * leaderboard for this term beside them (both from content.ts; 0011_featured_posts.sql). Writers who did
 * not opt in to the leaderboard show as "A member", as on /leaderboard. A tag or category filter hides
 * the hero and shows only the matching posts. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getFeaturedPost, getWriters, termOf, fmtRiyadh, monthOf } from '../../lib/content';
const [posts, featuredPost, writers] = await Promise.all([getPosts(), getFeaturedPost(), getWriters()]);
const iso = (d: Date) => d.toISOString().slice(0, 10);
const mon = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' });
const dayYear = (d: Date) => `${d.getUTCDate()}, ${d.getUTCFullYear()}`;
const tag = Astro.url.searchParams.get('tag');
const category = Astro.url.searchParams.get('category');
const featured = tag || category ? null : featuredPost;
const shown = posts.filter(
  (p) => p.id !== featured?.id && (!tag || p.tags.includes(tag)) && (!category || p.category === category),
);
const count = (n: number, one: string) => `${n} ${one}${n === 1 ? '' : 's'}`;
// Last month's pick stays up until a reviewer picks one for this month, so it is labelled with its month.
const flag =
  featured && featured.month !== monthOf(new Date())
    ? `Featured post · ${fmtRiyadh(new Date(`${featured.month}T12:00:00Z`), { month: 'long' })}`
    : 'Featured post of the month';
---

<BaseLayout
  title="Blog"
  description="Written by members of the KFUPM Computer Club: what we did, what we taught, and what we learned."
>
  <section class="page-head">
    <div class="container">
      <h1 class="ccmark ccmark--text" aria-label="CC Blogs">
        <b>CC</b>
        <span>Blogs</span>
      </h1>
      <p class="lead">
        Event recaps, tutorials and what we learned. <a href="/rss.xml">RSS</a>
      </p>
      {(tag || category) && (
        <p class="mono">
          Showing {tag ? `#${tag}` : category} · <a href="/blog">all posts</a>
        </p>
      )}
    </div>
  </section>
  <section class="section">
    <div class="container blog__grid">
      <div class="posts">
        {featured && (
          <a class="post post--featured" href={`/blog/${featured.slug}`} dir={featured.dir}>
            <div class="post__body">
              <p class="post__flag mono">{flag}</p>
              <h2 class="post__title">{featured.title}</h2>
              <p class="post__author">
                {featured.authorName}
                {featured.category && ` · ${featured.category}`} ·{' '}
                {fmtRiyadh(featured.date, { day: 'numeric', month: 'short', year: 'numeric' })}
              </p>
              <p class="post__excerpt">{featured.excerpt}</p>
            </div>
          </a>
        )}
        {shown.map((p) => (
          <a class="post reveal" href={`/blog/${p.slug}`} dir={p.dir}>
            <time class="post__date" datetime={iso(p.date)}>
              <b>{mon(p.date)}</b>
              <span>{dayYear(p.date)}</span>
            </time>
            <div class="post__body">
              <h2 class="post__title">{p.title}</h2>
              <p class="post__author">
                {p.authorName}
                {p.category && ` · ${p.category}`}
              </p>
              <p class="post__excerpt">{p.excerpt}</p>
            </div>
          </a>
        ))}
        {shown.length === 0 && !featured && <p class="lead lead--muted">Nothing here yet.</p>}
      </div>
      <aside class="blog__side">
        <div class="card writers">
          <h2 class="h3">Top writers</h2>
          <p class="mono writers__term">{termOf(new Date())} · posts published</p>
          {writers.length ? (
            <ol>
              {writers.map((w) => (
                <li class={w.name ? undefined : 'writers__anon'}>
                  {w.handle ? <a href={`/u/${w.handle}`}>{w.name}</a> : <span>{w.name || 'A member'}</span>}
                  <span class="mono">{count(w.posts, 'post')}</span>
                </li>
              ))}
            </ol>
          ) : (
            <p class="hint">No posts published this term yet. Yours could be first.</p>
          )}
          <p class="hint">Names show only for members who chose to appear on the leaderboard.</p>
        </div>
        <p style="margin-top:16px">
          <a class="btn btn--ghost" href="/me/posts/new">
            Write a post <span aria-hidden="true">→</span>
          </a>
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>
