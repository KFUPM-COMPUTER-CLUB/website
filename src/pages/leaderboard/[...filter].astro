---
/* The public leaderboard, cached like every public page. The filter lives in the path rather than a
 * query string so each view is its own ISR page and works without JavaScript: /leaderboard (this
 * term, every category), /leaderboard/<category>, /leaderboard/all-time and
 * /leaderboard/all-time/<category>. Totals come from leaderboard() in 0006_leaderboard.sql, which
 * names only members who ticked "Show me on the leaderboard" on their profile; everyone else keeps
 * their place as "A member", so ranks stay honest. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLeaderboard, termOf } from '../../lib/content';
import { dbReady } from '../../lib/env';
import { POINT_CATEGORIES, POINT_VALUES, type LeaderPeriod, type PointCategory } from '../../lib/types';
import { t, localePath, type Lang } from '../../lib/i18n';

type Filter = PointCategory | 'all';
const parts = (Astro.params.filter || '').split('/').filter(Boolean);
const lang = (Astro.currentLocale ?? 'en') as Lang;
const period: LeaderPeriod = parts[0] === 'all-time' ? 'all' : 'term';
if (period === 'all') parts.shift();
const category = (parts[0] || 'all') as Filter;
if (parts.length > 1 || (category !== 'all' && !POINT_CATEGORIES.includes(category)))
  return new Response(null, { status: 404 });

const rows = await getLeaderboard(period, category);
const term = termOf(new Date());
const localizedTerm =
  lang === 'ar'
    ? term
        .replace('Fall', t(lang, 'leaderboard.termFall'))
        .replace('Spring', t(lang, 'leaderboard.termSpring'))
        .replace('Summer', t(lang, 'leaderboard.termSummer'))
    : term;
const href = (p: LeaderPeriod, c: Filter) =>
  `/leaderboard${p === 'all' ? '/all-time' : ''}${c === 'all' ? '' : `/${c}`}`;
const periods = [
  { p: 'term' as LeaderPeriod, label: term },
  { p: 'all' as LeaderPeriod, label: t(lang, 'leaderboard.allTime') },
].map((x) => ({ ...x, href: href(x.p, category), on: x.p === period }));
const filters = (['all', 'events', 'posts', 'flag', 'competitions'] as Filter[]).map((c) => ({
  label:
    c === 'all'
      ? t(lang, 'leaderboard.everything')
      : t(
          lang,
          `leaderboard.category.${c}` as
            | 'leaderboard.category.events'
            | 'leaderboard.category.posts'
            | 'leaderboard.category.flag'
            | 'leaderboard.category.competitions',
        ),
  href: href(period, c),
  on: c === category,
}));
const leaders = rows.map((r) => ({
  ...r,
  label: r.handle ? r.name || `@${r.handle}` : lang === 'ar' ? 'عضو' : 'A member',
  initial: (r.name || '?').slice(0, 1),
}));
const scope = `${period === 'term' ? localizedTerm : t(lang, 'leaderboard.allTime')}${
  category === 'all'
    ? ''
    : `${lang === 'ar' ? '،' : ','} ${filters.find((x) => x.on)?.label.toLocaleLowerCase(lang === 'ar' ? 'ar' : 'en-US')}`
}`;
const empty = !dbReady() ? t(lang, 'leaderboard.noDatabase') : `${t(lang, 'leaderboard.noPoints')} ${scope}.`;
---

<BaseLayout title={t(lang, 'leaderboard.title')} description={t(lang, 'leaderboard.description')}>
  <section class="page-head page-head--compact">
    <div class="container">
      <span class="eyebrow">{t(lang, 'leaderboard.title')}</span>
      <h1 class="h1">{t(lang, 'leaderboard.heading')}</h1>
      <p class="lead">
        {t(lang, 'leaderboard.lead')} {scope}.
      </p>
    </div>
  </section>

  <nav class="filters" aria-label={t(lang, 'leaderboard.filters')}>
    <div class="container filters__inner leaders__filters">
      <div class="chips">
        {periods.map((x) => (
          <a class={x.on ? 'chip is-on' : 'chip'} href={x.href} aria-current={x.on ? 'page' : undefined}>
            {x.label}
          </a>
        ))}
      </div>
      <div class="chips">
        {filters.map((x) => (
          <a class={x.on ? 'chip is-on' : 'chip'} href={x.href} aria-current={x.on ? 'page' : undefined}>
            {x.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <section class="section">
    <div class="container leaders__grid">
      <div>
        {leaders.length ? (
          <ol class="leaders">
            {leaders.map((r) => (
              <li class={r.handle ? 'leader' : 'leader leader--anon'}>
                <span class="leader__rank">{r.rank}</span>
                {r.avatar ? (
                  <img class="leader__photo" src={r.avatar} alt="" width="44" height="44" loading="lazy" />
                ) : (
                  <span class="leader__photo leader__photo--blank" aria-hidden="true">
                    {r.handle ? r.initial : '·'}
                  </span>
                )}
                <span class="leader__name">
                  {r.handle ? <a href={localePath(lang, `/u/${r.handle}`)}>{r.label}</a> : r.label}
                </span>
                <span class="leader__total">
                  <b>{r.total}</b> {t(lang, 'leaderboard.points')}
                </span>
              </li>
            ))}
          </ol>
        ) : (
          <p class="lead lead--muted">{empty}</p>
        )}
      </div>
      <aside class="card leaders__how">
        <h2 class="h3">{t(lang, 'leaderboard.how')}</h2>
        <ul>
          <li>
            <b>{POINT_VALUES.events}</b> {t(lang, 'leaderboard.eachEvent')}
          </li>
          <li>
            <b>{POINT_VALUES.posts}</b> {t(lang, 'leaderboard.eachPost')}
          </li>
          <li>
            <b>{POINT_VALUES.flag}</b> {t(lang, 'leaderboard.findFlag')} <a href={localePath(lang, '/flag')}>flag</a>
          </li>
          <li>{t(lang, 'leaderboard.competition')}</li>
        </ul>
        <p class="hint">
          {t(lang, 'leaderboard.visibility')} <i>Show me on the leaderboard</i> on your{' '}
          <a href="/me/profile">profile</a>. {t(lang, 'leaderboard.visibilityEnd')} "A member".
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>
