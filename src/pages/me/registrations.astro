---
/* The member's reservations. Upcoming and past are split with a day of grace after the end. The
 * Shown/Hidden switch toggles show_on_profile: reservations are private until the member opts one
 * event into their public profile. Both the switch and Cancel post to the register route. */
import MeLayout from '../../components/MeLayout.astro';
import { serviceClient } from '../../lib/supabase';
import { fmtRiyadh } from '../../lib/content';
const { user } = Astro.locals;
const { data: regs } = await serviceClient()
  .from('registrations')
  .select(
    'id,event_id,email_copy,attended,show_on_profile,created_at,events(id,slug,title,starts_at,ends_at,location,x_url)',
  )
  .eq('user_id', user!.id)
  .order('created_at', { ascending: false });
const upcoming = (regs || []).filter(
  (r: any) => r.events && new Date(r.events.ends_at || r.events.starts_at).valueOf() >= Date.now() - 86_400_000,
);
const past = (regs || []).filter((r: any) => !upcoming.includes(r));
const when = (e: any) =>
  fmtRiyadh(new Date(e.starts_at), { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
---

<MeLayout
  title="My events"
  lead="Spots you reserved. Cancel any time before the event. Events are private unless you choose to show one on your profile."
>
  <div class="card">
    <h2 class="h3">Upcoming</h2>
    {upcoming.length ? (
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Event</th>
              <th>When</th>
              <th>Where</th>
              <th>On my profile</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {upcoming.map((r: any) => (
              <tr>
                <td>
                  <a href={`/timeline#ev-${r.events.slug}`}>{r.events.title}</a>
                </td>
                <td class="mono">{when(r.events)}</td>
                <td>{r.events.location}</td>
                <td>
                  <form data-astro-reload method="post" action={`/api/events/${r.events.id}/register`}>
                    <input type="hidden" name="_action" value="show" />
                    <button class={`btn btn--tiny ${r.show_on_profile ? '' : 'btn--ghost'}`} type="submit">
                      {r.show_on_profile ? 'Shown' : 'Hidden'}
                    </button>
                  </form>
                </td>
                <td>
                  <form data-astro-reload method="post" action={`/api/events/${r.events.id}/register`}>
                    <input type="hidden" name="cancel" value="1" />
                    <button class="btn btn--tiny btn--ghost" type="submit">
                      Cancel
                    </button>
                  </form>{' '}
                  <a class="btn btn--tiny btn--ghost" href={`/api/events/${r.events.slug}.ics`}>
                    .ics
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="hint">
        Nothing reserved. Open events are on the <a href="/timeline">timeline</a>.
      </p>
    )}
  </div>
  <div class="card">
    <h2 class="h3">Past</h2>
    {past.length ? (
      <ul>
        {past.map((r: any) => (
          <li>
            {r.events?.title} · <span class="mono">{r.events ? when(r.events) : ''}</span>{' '}
            {r.attended && <span class="chip chip--published">attended</span>}{' '}
            {r.events && (
              <form
                data-astro-reload
                style="display:inline"
                method="post"
                action={`/api/events/${r.events.id}/register`}
              >
                <input type="hidden" name="_action" value="show" />
                <button class="btn btn--tiny btn--ghost" type="submit">
                  {r.show_on_profile ? 'Shown on profile · hide' : 'Show on profile'}
                </button>
              </form>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="hint">No past events yet.</p>
    )}
  </div>
</MeLayout>
