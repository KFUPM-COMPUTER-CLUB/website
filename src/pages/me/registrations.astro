---
import MeLayout from '../../components/MeLayout.astro';
import { serviceClient } from '../../lib/supabase';
import { fmtRiyadh } from '../../lib/content';
const { user } = Astro.locals;
const { data: regs } = await serviceClient().from('registrations').select('id,event_id,email_copy,attended,created_at,events(id,slug,title,starts_at,ends_at,location,x_url)').eq('user_id', user!.id).order('created_at', { ascending: false });
const upcoming = (regs || []).filter((r: any) => r.events && new Date(r.events.ends_at || r.events.starts_at).valueOf() >= Date.now() - 86_400_000);
const past = (regs || []).filter((r: any) => !upcoming.includes(r));
const when = (e: any) => fmtRiyadh(new Date(e.starts_at), { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
---
<MeLayout title="My events" lead="Spots you reserved. Cancel any time before the event.">
  <div class="card">
    <h2 class="h3">Upcoming</h2>
    {upcoming.length ? <div class="table-wrap"><table class="table"><thead><tr><th>Event</th><th>When</th><th>Where</th><th></th></tr></thead><tbody>{upcoming.map((r: any) => <tr><td><a href={`/timeline#ev-${r.events.slug}`}>{r.events.title}</a></td><td class="mono">{when(r.events)}</td><td>{r.events.location}</td><td><form method="post" action={`/api/events/${r.events.id}/register`}><input type="hidden" name="cancel" value="1" /><button class="btn btn--tiny btn--ghost" type="submit">Cancel</button></form> <a class="btn btn--tiny btn--ghost" href={`/api/events/${r.events.slug}.ics`}>.ics</a></td></tr>)}</tbody></table></div> : <p class="hint">Nothing reserved. Open events are on the <a href="/timeline">timeline</a>.</p>}
  </div>
  <div class="card">
    <h2 class="h3">Past</h2>
    {past.length ? <ul>{past.map((r: any) => <li>{r.events?.title} · <span class="mono">{r.events ? when(r.events) : ''}</span> {r.attended && <span class="chip chip--published">attended</span>}</li>)}</ul> : <p class="hint">No past events yet.</p>}
  </div>
</MeLayout>
