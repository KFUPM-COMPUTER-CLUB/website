---
import MeLayout from '../../../components/MeLayout.astro';
import { serviceClient } from '../../../lib/supabase';
const { user } = Astro.locals;
const { data: posts } = await serviceClient().from('posts').select('id,slug,title,status,updated_at,published_at, post_reviews(comment,status_set,created_at)').eq('author_id', user!.id).order('updated_at', { ascending: false });
const latestNote = (p: any) => (p.post_reviews || []).sort((a: any, b: any) => (a.created_at < b.created_at ? 1 : -1))[0];
---
<MeLayout title="My posts" lead="Drafts save as you type. Submit when it is ready; a reviewer answers by email.">
  <p><a class="btn btn--small" href="/me/posts/new">Write a post <span aria-hidden="true">→</span></a></p>
  <div class="table-wrap" style="margin-top:16px">
    <table class="table">
      <thead><tr><th>Title</th><th>Status</th><th>Reviewer note</th><th>Updated</th><th></th></tr></thead>
      <tbody>
        {(posts || []).map((p: any) => (
          <tr>
            <td><a href={`/me/posts/${p.id}/edit`}>{p.title}</a>{p.status === 'published' && <> · <a href={`/blog/${p.slug}`}>view</a></>}</td>
            <td><span class={`chip chip--${p.status}`}>{p.status.replace('_', ' ')}</span></td>
            <td>{latestNote(p)?.comment || ''}</td>
            <td class="mono">{String(p.updated_at).slice(0, 10)}</td>
            <td>{['draft', 'changes_requested'].includes(p.status) && <form method="post" action={`/api/posts/${p.id}/submit`}><button class="btn btn--tiny" type="submit">Submit</button></form>}</td>
          </tr>
        ))}
        {!posts?.length && <tr><td colspan="5" class="hint">No posts yet.</td></tr>}
      </tbody>
    </table>
  </div>
</MeLayout>
