---
/* The post editor page (the form is components/PostEditor.astro, which /dev/editor reuses).
 * Reviewers can open anyone's post here ("Open in editor" on the review page). "locked" mirrors the
 * API's rule: an author cannot edit while the post is under review or published, so the fields are
 * disabled and editor.js starts read-only. Reviewer notes are shown above the form. */
import MeLayout from '../../../../components/MeLayout.astro';
import PostEditor from '../../../../components/PostEditor.astro';
import { serviceClient } from '../../../../lib/supabase';
import { atLeast } from '../../../../lib/types';
import { isUuid } from '../../../../lib/api';
const { user, role } = Astro.locals;
if (!isUuid(Astro.params.id)) return new Response(null, { status: 404 });
const { data: post } = await serviceClient()
  .from('posts')
  .select('*, post_reviews(comment,status_set,created_at)')
  .eq('id', Astro.params.id)
  .maybeSingle();
if (!post || (post.author_id !== user!.id && !atLeast(role, 'reviewer'))) return new Response(null, { status: 404 });
const locked =
  post.author_id === user!.id && !atLeast(role, 'reviewer') && !['draft', 'changes_requested'].includes(post.status);
const notes = (post.post_reviews || []).sort((a: any, b: any) => (a.created_at < b.created_at ? 1 : -1));
---

<MeLayout title={post.title}>
  <PostEditor post={post} notes={notes} locked={locked} />
</MeLayout>
