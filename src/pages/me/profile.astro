---
/* /me/profile: the signed-in member's profile form (components/ProfileForm.astro). The linked providers
 * are read from the session client here because the middleware keeps only id and email on Astro.locals. */
import MeLayout from '../../components/MeLayout.astro';
import ProfileForm from '../../components/ProfileForm.astro';
import { googleEnabled } from '../../lib/env';
import { sessionClient } from '../../lib/supabase';
const p = Astro.locals.profile!;
const {
  data: { user },
} = await sessionClient(Astro.request, Astro.cookies).auth.getUser();
const providers: string[] = (user?.identities || []).map((i: any) => i.provider);
---

<MeLayout title="Profile" lead="What people see on your public profile, plus the details only admins see.">
  <ProfileForm profile={p} providers={providers} googleOn={googleEnabled()} />
</MeLayout>
