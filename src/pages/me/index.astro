---
/* Member dashboard. Everything under /me is personal: never cached (excluded from ISR) and only
 * reached once the middleware has put a signed-in, onboarded session on Astro.locals.
 * Reads use the service client, not the member's own token: the group links live under a private
 * settings key that row level security hides from members, and one client keeps the code simple.
 * The price is that nothing filters rows for us, so every query here must scope by user.id itself. */
import MeLayout from '../../components/MeLayout.astro';
import { serviceClient } from '../../lib/supabase';
import { getWhatsappGroups } from '../../lib/whatsapp';
import { fmtRiyadh } from '../../lib/content';
import { getMyBadges } from '../../lib/badges';
import Badges from '../../components/Badges.astro';
import { wrappedNow } from '../../lib/stats';
const { user, profile, role } = Astro.locals;
// Semester Wrapped is linked from here in a term's last four weeks and the two weeks after (src/lib/stats.ts).
const wrapped = wrappedNow(new Date());
const sb = serviceClient();
const [{ data: posts }, { data: regs }, groups, { data: points }, badges] = await Promise.all([
  sb
    .from('posts')
    .select('id,slug,title,status,updated_at')
    .eq('author_id', user!.id)
    .order('updated_at', { ascending: false })
    .limit(5),
  sb
    .from('registrations')
    .select('event_id,attended,events(slug,title,starts_at,location)')
    .eq('user_id', user!.id)
    .order('created_at', { ascending: false })
    .limit(5),
  getWhatsappGroups(),
  // Every award is a row (0005_points.sql), so the total is their sum and the latest few explain it.
  sb
    .from('points')
    .select('amount,reason,awarded_at')
    .eq('user_id', user!.id)
    .order('awarded_at', { ascending: false }),
  // Badges (0014_badges.sql): all of them here, whatever the member shows on their public profile.
  getMyBadges(user!.id),
]);
const pointsTotal = (points || []).reduce((s: number, r: any) => s + r.amount, 0);
const welcome = Astro.url.searchParams.has('welcome');
---

<MeLayout
  title={
    welcome
      ? `Welcome, ${profile?.name?.split(' ')[0] || 'member'}.`
      : `Hi, ${profile?.name?.split(' ')[0] || 'member'}.`
  }
  lead={welcome ? 'You are in. The groups below are where everything happens.' : undefined}
>
  {wrapped.linked && (
    <div class="card" style="margin-bottom:16px">
      <h2 class="h3">Your {wrapped.term.label} Wrapped</h2>
      <p class="hint">Your term in numbers, with an image to share.</p>
      <a class="btn btn--small" href={`/me/wrapped?term=${wrapped.term.key}`}>
        Open Wrapped
      </a>
    </div>
  )}
  <div class="card">
    <h2 class="h3">WhatsApp groups</h2>
    {groups.length ? (
      <div class="wa-links">
        {groups.map((g) => (
          <div class="wa-links__row">
            <a href={g.url} target="_blank" rel="noopener">
              <b>{g.label}</b>
              <span class="mono">Open ↗</span>
            </a>
            <button type="button" class="copy" data-copy={g.url} aria-label={`Copy ${g.label} invite link`}>
              Copy
              <span class="copy__tip" aria-hidden="true">
                Copied ✓
              </span>
              <span class="visually-hidden" aria-live="polite" data-copy-status />
            </button>
          </div>
        ))}
      </div>
    ) : (
      <p class="hint">The group links are not set yet. An admin adds them under Settings.</p>
    )}
    <p class="hint" style="margin:12px 0 0">
      These links are for members only. Please do not post them publicly.
    </p>
  </div>
  <div class="cards" style="margin-top:16px">
    <div class="stat">
      <b>{posts?.length || 0}</b>
      <span>recent posts</span>
    </div>
    <div class="stat">
      <b>{regs?.length || 0}</b>
      <span>reservations</span>
    </div>
    <div class="stat">
      <b>{pointsTotal}</b>
      <span>points</span>
    </div>
    <div class="stat">
      <b style="font-size:20px">{role}</b>
      <span>role</span>
    </div>
    {profile?.committee && (
      <div class="stat">
        <b style="font-size:20px">{profile.committee.name}</b>
        <span>committee</span>
      </div>
    )}
  </div>
  <div class="card" style="margin-top:16px">
    <h2 class="h3">My posts</h2>
    {posts?.length ? (
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Status</th>
              <th>Updated</th>
            </tr>
          </thead>
          <tbody>
            {posts.map((p: any) => (
              <tr>
                <td>
                  <a href={`/me/posts/${p.id}/edit`}>{p.title}</a>
                </td>
                <td>
                  <span class={`chip chip--${p.status}`}>{p.status.replace('_', ' ')}</span>
                </td>
                <td class="mono">{String(p.updated_at).slice(0, 10)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="hint">No posts yet.</p>
    )}
    <p style="margin:14px 0 0">
      <a class="btn btn--small" href="/me/posts/new">
        Write a post <span aria-hidden="true">→</span>
      </a>{' '}
      <a class="btn btn--small btn--ghost" href="/me/posts">
        All my posts
      </a>
    </p>
  </div>
  <div class="card" style="margin-top:16px">
    <h2 class="h3">My reservations</h2>
    {regs?.length ? (
      <ul>
        {regs.map((r: any) => (
          <li>
            <a href={`/timeline#ev-${r.events?.slug}`}>{r.events?.title}</a> ·{' '}
            <span class="mono">
              {r.events?.starts_at ? fmtRiyadh(new Date(r.events.starts_at), { day: 'numeric', month: 'short' }) : ''}
            </span>
            {r.attended && (
              <span class="chip chip--published" style="margin-left:8px">
                attended
              </span>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="hint">
        No reservations yet. Upcoming events are on the <a href="/timeline">timeline</a>.
      </p>
    )}
  </div>
  <div class="card" style="margin-top:16px">
    <h2 class="h3">My points</h2>
    {points?.length ? (
      <ul>
        {points.slice(0, 5).map((r: any) => (
          <li>
            <b class="mono">{r.amount > 0 ? `+${r.amount}` : r.amount}</b> {r.reason} ·{' '}
            <span class="mono">
              {fmtRiyadh(new Date(r.awarded_at), { day: 'numeric', month: 'short', year: 'numeric' })}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="hint">No points yet. Attend an event, publish a post or find the flag, and they add up here.</p>
    )}
  </div>
  <div class="card" style="margin-top:16px">
    <h2 class="h3">My badges</h2>
    {badges.length ? (
      <Badges badges={badges} />
    ) : (
      <p class="hint">
        No badges yet. Publish a first post, attend five events or find the flag on the site to earn your first.
      </p>
    )}
    {profile?.show_badges === false && (
      <p class="hint" style="margin:12px 0 0">
        Hidden on your public profile. <a href="/me/profile">Show them</a>
      </p>
    )}
  </div>
  {profile?.handle && (
    <p style="margin-top:20px">
      <a class="link-arrow" href={`/u/${profile.handle}`}>
        See my public profile →
      </a>
    </p>
  )}
</MeLayout>
