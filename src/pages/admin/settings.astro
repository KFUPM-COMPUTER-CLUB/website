---
import AdminLayout from '../../components/AdminLayout.astro';
import { serviceClient } from '../../lib/supabase';
if (Astro.locals.role !== 'admin') return new Response('Admins only', { status: 403 });
const { data } = await serviceClient().from('settings').select('key,value');
const v: Record<string, any> = Object.fromEntries((data || []).map((r: any) => [r.key, r.value]));
const site = v.site || {}, links = v.links || {}, banner = v.banner || {}, groups: any[] = Array.isArray(v.whatsapp_groups) ? v.whatsapp_groups : [], tpl = v.email_templates || {}, made: any[] = Array.isArray(v.made_by) ? v.made_by : [];
const LINKS = [['join', 'Join form (optional, overrides the built-in join page)'], ['instagram', 'Instagram'], ['x', 'X'], ['linkedin', 'LinkedIn'], ['github', 'GitHub'], ['solvers', 'Flag solvers endpoint (optional)']];
---
<AdminLayout title="Settings">
  <form class="form card" id="site" method="post" action="/api/admin/settings"><input type="hidden" name="key" value="site" />
    <h2 class="h3">Club</h2>
    <div class="form__row"><div class="field"><label for="name">Name</label><input class="input" id="name" name="name" value={site.name || 'KFUPM Computer Club'} /></div><div class="field"><label for="short">Short name</label><input class="input" id="short" name="short" value={site.short || 'CCKFUPM'} /></div></div>
    <div class="field"><label for="tagline">Tagline</label><input class="input" id="tagline" name="tagline" value={site.tagline || ''} /></div>
    <div class="field"><label for="intro">Intro (under CC | KFUPM)</label><input class="input" id="intro" name="intro" value={site.intro || ''} maxlength="240" /></div>
    <div class="field"><label for="description">Description (search engines)</label><textarea class="textarea" id="description" name="description" maxlength="300">{site.description || ''}</textarea></div>
    <div class="form__row"><div class="field"><label for="email">Club email</label><input class="input" id="email" name="email" type="email" value={site.email || ''} /></div><div class="field"><label for="missionAr">Mission (Arabic)</label><input class="input" id="missionAr" name="missionAr" dir="rtl" value={site.missionAr || ''} /></div></div>
    <button class="btn btn--small" type="submit">Save club</button>
  </form>
  <form class="form card" id="links" method="post" action="/api/admin/settings" style="margin-top:16px"><input type="hidden" name="key" value="links" />
    <h2 class="h3">Links</h2>
    {LINKS.map(([k, label]) => <div class="field"><label for={`l-${k}`}>{label}</label><input class="input" id={`l-${k}`} name={k} type="url" value={links[k] || ''} placeholder="https://…" /></div>)}
    <button class="btn btn--small" type="submit">Save links</button>
  </form>
  <form class="form card" id="whatsapp_groups" method="post" action="/api/admin/settings" style="margin-top:16px"><input type="hidden" name="key" value="whatsapp_groups" />
    <h2 class="h3">Members-only group links</h2>
    <p class="hint">WhatsApp, Discord or any invite link. Shown to members right after onboarding, on their dashboard and in the welcome email. Never public: the database refuses invite links under any public setting.</p>
    {[...groups, {}, {}].slice(0, Math.max(groups.length + 1, 2)).map((g: any) => <div class="form__row"><div class="field"><label>Label</label><input class="input" name="label[]" value={g.label || ''} placeholder="General" /></div><div class="field"><label>Invite link</label><input class="input" name="url[]" type="url" value={g.url || ''} placeholder="https://chat.whatsapp.com/…" /></div></div>)}
    <button class="btn btn--small" type="submit">Save groups</button>
  </form>
  <form class="form card" id="banner" method="post" action="/api/admin/settings" style="margin-top:16px"><input type="hidden" name="key" value="banner" />
    <h2 class="h3">Announcement banner</h2>
    <div class="field"><label for="b-text">Text</label><input class="input" id="b-text" name="text" value={banner.text || ''} maxlength="160" /></div>
    <div class="field"><label for="b-url">Link (optional)</label><input class="input" id="b-url" name="url" type="url" value={banner.url || ''} /></div>
    <label class="check"><input type="checkbox" name="visible" value="1" checked={!!banner.visible} /> Show the banner</label>
    <button class="btn btn--small" type="submit">Save banner</button>
  </form>
  <form class="form card" id="email_templates" method="post" action="/api/admin/settings" style="margin-top:16px"><input type="hidden" name="key" value="email_templates" />
    <h2 class="h3">Email templates</h2>
    <p class="hint">Leave a field empty to use the built-in text. Placeholders: {'{{name}} {{siteUrl}} {{whatsappLinks}} {{postTitle}} {{status}} {{comment}} {{eventTitle}} {{eventWhen}} {{eventLocation}} {{calendarLinks}}'}</p>
    {[['welcome', 'Welcome'], ['status', 'Post status change'], ['registration', 'Reservation copy']].map(([k, label]) => <><div class="field"><label for={`${k}_subject`}>{label}: subject</label><input class="input" id={`${k}_subject`} name={`${k}_subject`} value={tpl[k]?.subject || ''} /></div><div class="field"><label for={`${k}_html`}>{label}: body (HTML allowed)</label><textarea class="textarea" id={`${k}_html`} name={`${k}_html`}>{tpl[k]?.html || ''}</textarea></div></>)}
    <button class="btn btn--small" type="submit">Save templates</button>
  </form>
  <form class="form card" id="made_by" method="post" action="/api/admin/settings" style="margin-top:16px"><input type="hidden" name="key" value="made_by" />
    <h2 class="h3">Made by (footer credit)</h2>
    {[...made, {}].map((m: any) => <div class="form__row"><div class="field"><label>Name</label><input class="input" name="name[]" value={m.name || ''} /></div><div class="field"><label>GitHub username</label><input class="input" name="github[]" value={m.github || ''} /></div></div>)}
    <button class="btn btn--small" type="submit">Save credit</button>
  </form>
</AdminLayout>
