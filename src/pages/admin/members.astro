---
/* Member list (admin only): search, role, suspend, delete, CSV. This page and the CSV are the only
 * places email and phone are shown. The search term is stripped of PostgREST filter syntax (commas,
 * parentheses, quotes, percent) before it goes into the or() filter, otherwise a typed comma would
 * change the query. The role filter runs in JS because the role lives in a joined table. */
import AdminLayout from '../../components/AdminLayout.astro';
import { serviceClient } from '../../lib/supabase';
if (Astro.locals.role !== 'admin') return new Response('Admins only', { status: 403 });
const q = (Astro.url.searchParams.get('q') || '').trim();
const roleFilter = Astro.url.searchParams.get('role') || '';
let query = serviceClient()
  .from('profiles')
  .select('id,handle,name,email,phone,major,year,onboarded,suspended,created_at, user_roles(role)')
  .order('created_at', { ascending: false })
  .limit(200);
const term = q.replace(/[,()"\\%]/g, '');
if (term) query = query.or(`name.ilike.%${term}%,email.ilike.%${term}%,handle.ilike.%${term}%,phone.ilike.%${term}%`);
const { data } = await query;
const rows = (data || [])
  .map((p: any) => ({ ...p, role: p.user_roles?.role || 'member' }))
  .filter((p: any) => !roleFilter || p.role === roleFilter);
const ROLES = ['member', 'editor', 'reviewer', 'officer', 'admin'];
const detail = Astro.url.searchParams.get('id');
const one = detail ? rows.find((r: any) => r.id === detail) : null;
---

<AdminLayout
  title="Members"
  lead="Search, roles, suspension and export. Phone and email are visible here only."
  live={false}
>
  <form class="inline-form" method="get" style="margin-bottom:16px">
    <input class="input" name="q" value={q} placeholder="name, email, handle or phone" style="max-width:320px" />
    <select class="select" name="role" style="max-width:160px">
      <option value="">any role</option>
      {ROLES.map((r) => (
        <option value={r} selected={roleFilter === r}>
          {r}
        </option>
      ))}
    </select>
    <button class="btn btn--small" type="submit">
      Search
    </button>
    <a class="btn btn--small btn--ghost" href="/api/admin/members">
      Export CSV
    </a>
  </form>
  {one && (
    <div class="card" style="margin-bottom:16px">
      <h2 class="h3">
        {one.name} <span class="mono">@{one.handle}</span>
      </h2>
      <dl class="form__row">
        <div>
          <dt class="field__label">Email</dt>
          <dd>{one.email}</dd>
        </div>
        <div>
          <dt class="field__label">Phone</dt>
          <dd>{one.phone}</dd>
        </div>
        <div>
          <dt class="field__label">Major · year</dt>
          <dd>
            {one.major} · {one.year}
          </dd>
        </div>
        <div>
          <dt class="field__label">Joined</dt>
          <dd>{String(one.created_at).slice(0, 10)}</dd>
        </div>
      </dl>
      <p>
        <a class="link-arrow" href={`/u/${one.handle}`}>
          Public profile →
        </a>{' '}
        ·{' '}
        <a class="link-arrow" href={`/admin/board/new`}>
          Make officer (add to board) →
        </a>
      </p>
    </div>
  )}
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Member</th>
          <th>Contact</th>
          <th>Role</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((p: any) => (
          <tr>
            <td>
              <a href={`?q=${encodeURIComponent(q)}&id=${p.id}`}>{p.name || '(no name)'}</a>
              <br />
              <span class="mono">
                @{p.handle || '—'} · {p.major || ''}
              </span>
            </td>
            <td class="mono">
              {p.email}
              <br />
              {p.phone}
            </td>
            <td>
              <form data-astro-reload class="inline-form" method="post" action="/api/admin/members">
                <input type="hidden" name="_action" value="role" />
                <input type="hidden" name="user_id" value={p.id} />
                <input type="hidden" name="q" value={q} />
                <select class="select" name="role" style="max-width:130px;padding:6px 30px 6px 10px;font-size:13px">
                  {ROLES.map((r) => (
                    <option value={r} selected={p.role === r}>
                      {r}
                    </option>
                  ))}
                </select>
                <button class="btn btn--tiny" type="submit">
                  Set
                </button>
              </form>
            </td>
            <td>
              {p.suspended ? (
                <span class="chip chip--changes_requested">suspended</span>
              ) : p.onboarded ? (
                <span class="chip chip--published">active</span>
              ) : (
                <span class="chip">not onboarded</span>
              )}
            </td>
            <td style="white-space:nowrap">
              <form data-astro-reload method="post" action="/api/admin/members">
                <input type="hidden" name="_action" value="suspend" />
                <input type="hidden" name="user_id" value={p.id} />
                <input type="hidden" name="q" value={q} />
                <button class="btn btn--tiny btn--ghost" type="submit">
                  {p.suspended ? 'Reinstate' : 'Suspend'}
                </button>
              </form>
              <form
                data-astro-reload
                method="post"
                action="/api/admin/members"
                onsubmit="return confirm('Delete this account and all its data?')"
              >
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="user_id" value={p.id} />
                <input type="hidden" name="q" value={q} />
                <button class="btn btn--tiny btn--danger" type="submit">
                  Delete
                </button>
              </form>
            </td>
          </tr>
        ))}
        {!rows.length && (
          <tr>
            <td colspan="5" class="hint">
              No members match.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
