---
/* Starter-content import (admin only). The browser drives the loop: each POST to /api/admin/import
 * does one small batch and replies with the next step, so no single request outlasts the serverless
 * time limit. The counts above the button show how far a previous run got. */
import AdminLayout from '../../components/AdminLayout.astro';
import { totalMediaSteps } from '../../lib/importer';
import { serviceClient } from '../../lib/supabase';
if (Astro.locals.role !== 'admin') return new Response('Admins only', { status: 403 });
const sb = serviceClient();
const [{ count: media }, { count: events }, { count: posts }] = await Promise.all([
  sb.from('media').select('key', { count: 'exact', head: true }),
  sb.from('events').select('id', { count: 'exact', head: true }),
  sb.from('posts').select('id', { count: 'exact', head: true }),
]);
const files = totalMediaSteps();
---

<AdminLayout
  title="Import starter content"
  lead="Loads the photos, logos, events, polaroids, moments, impact numbers, partners, board, FAQ, settings and the three posts that ship with the site. Safe to run again: nothing duplicates, and anything you edited stays."
  live={false}
>
  <div class="cards" style="margin-bottom:20px">
    <div class="stat">
      <b>
        {media ?? 0}
        <small style="font-size:14px;color:var(--muted)"> / {files}</small>
      </b>
      <span>photos and logos in the library</span>
    </div>
    <div class="stat">
      <b>{events ?? 0}</b>
      <span>events</span>
    </div>
    <div class="stat">
      <b>{posts ?? 0}</b>
      <span>posts</span>
    </div>
  </div>
  <div class="card" data-import>
    <p>Takes two to three minutes the first time; the page shows progress. Keep it open.</p>
    <p class="form__actions">
      <button class="btn" type="button" data-import-start>
        Import starter content <span aria-hidden="true">→</span>
      </button>{' '}
      <label class="check">
        <input type="checkbox" data-import-force /> Re-upload every photo (slower)
      </label>
    </p>
    <p class="live" data-import-status></p>
    <pre
      class="prose"
      style="max-height:320px;overflow:auto;font-size:12px;padding:12px;background:#0B1A33"
      data-import-log
      hidden
    ></pre>
  </div>
</AdminLayout>

<script>
  import '../../scripts/import.js';
</script>
