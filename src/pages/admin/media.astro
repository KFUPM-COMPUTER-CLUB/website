---
/* Media library (officer and up): search, upload, alt text, delete. Draft uploads from the post editor
 * are listed as chips rather than pictures: they sit in the private bucket and would need signed URLs,
 * and they leave the draft state on their own when the post is published. */
import AdminLayout from '../../components/AdminLayout.astro';
import { atLeast } from '../../lib/types';
import { mediaImg } from '../../lib/photos';
import { serviceClient } from '../../lib/supabase';
if (!atLeast(Astro.locals.role, 'officer')) return new Response('Officers only', { status: 403 });
const q = (Astro.url.searchParams.get('q') || '').toLowerCase();
const { data: rows } = await serviceClient()
  .from('media')
  .select('key,kind,alt,width,height,sizes,path,published,post_id')
  .order('created_at', { ascending: false })
  .limit(600);
const all = (rows || []).filter(
  (m: any) => !q || m.key.toLowerCase().includes(q) || (m.alt || '').toLowerCase().includes(q),
);
---

<AdminLayout
  title="Media library"
  lead="Every photo and file on the site. Alt text here is what screen readers say and what search engines read."
  live={false}
>
  <form data-astro-reload
    class="form card"
    method="post"
    action="/api/admin/media"
    enctype="multipart/form-data"
    style="margin-bottom:20px"
  >
    <h2 class="h3">Upload a photo</h2>
    <div class="form__row">
      <div class="field">
        <label for="file">Image</label>
        <input class="input" id="file" name="file" type="file" accept="image/*" required />
      </div>
      <div class="field">
        <label for="alt">Alt text</label>
        <input class="input" id="alt" name="alt" maxlength="200" required placeholder="What is in the picture" />
      </div>
    </div>
    <div class="form__actions">
      <button class="btn btn--small" type="submit">
        Upload
      </button>
      <span class="hint">Converted to WebP in three sizes.</span>
    </div>
  </form>
  <form class="inline-form" method="get" style="margin-bottom:16px">
    <input class="input" name="q" value={q} placeholder="search key or alt" style="max-width:300px" />
    <button class="btn btn--small" type="submit">
      Search
    </button>
  </form>
  <div class="media-grid">
    {all.map((m) => (
      <figure>
        {!m.published ? (
          <span class="chip chip--draft">draft upload · {m.kind}</span>
        ) : m.kind === 'image' ? (
          <img src={mediaImg(m).src} alt={m.alt} loading="lazy" />
        ) : /^https:\/\//.test(m.sizes?.file || '') ? (
          <a class="pdf-card" href={m.sizes.file} target="_blank" rel="noopener">
            PDF
          </a>
        ) : (
          <span class="chip">PDF</span>
        )}
        <figcaption title={m.key}>{m.key}</figcaption>
        <form data-astro-reload class="inline-form" method="post" action="/api/admin/media">
          <input type="hidden" name="_action" value="alt" />
          <input type="hidden" name="key" value={m.key} />
          <input class="input" name="alt" value={m.alt} placeholder="alt text" style="padding:6px 8px;font-size:13px" />
          <button class="btn btn--tiny" type="submit">
            Save
          </button>
        </form>
        <form data-astro-reload method="post" action="/api/admin/media" onsubmit="return confirm('Delete this file?')">
          <input type="hidden" name="_action" value="delete" />
          <input type="hidden" name="key" value={m.key} />
          <button class="btn btn--tiny btn--ghost" type="submit">
            Delete
          </button>
        </form>
      </figure>
    ))}
    {!all.length && <p class="hint">No media yet. Run the seed import or upload a photo.</p>}
  </div>
</AdminLayout>
