---
/* Review page for one post (reviewer and up): the rendered post beside the decision form, which posts
 * to /api/admin/posts/<id>/review. set:html is safe here only because content_html was sanitised when
 * it was saved. Draft images resolve through /api/media, which signs them for reviewers. The status
 * select defaults to "published" for a submitted post, the usual answer. The Featured post card
 * features a published post for this month (0011_featured_posts.sql), naming the post it would replace. */
import AdminLayout from '../../../components/AdminLayout.astro';
import { serviceClient } from '../../../lib/supabase';
import { atLeast } from '../../../lib/types';
import { isUuid } from '../../../lib/api';
import { fmtRiyadh, monthOf } from '../../../lib/content';
if (!atLeast(Astro.locals.role, 'reviewer')) return new Response('Reviewers only', { status: 403 });
if (!isUuid(Astro.params.id)) return new Response(null, { status: 404 });
const month = monthOf(new Date());
const [{ data: post }, { data: current }] = await Promise.all([
  serviceClient()
    .from('posts')
    .select(
      '*, author:profiles!posts_author_id_fkey(name,handle,email), post_reviews(comment,status_set,created_at, reviewer:profiles!post_reviews_reviewer_id_fkey(name))',
    )
    .eq('id', Astro.params.id)
    .maybeSingle(),
  // The post featured this month, if any; an error (column missing before the migration) reads as none.
  serviceClient().from('posts').select('id,title').eq('featured_month', month).maybeSingle(),
]);
if (!post) return new Response(null, { status: 404 });
const notes = (post.post_reviews || []).sort((a: any, b: any) => (a.created_at < b.created_at ? 1 : -1));
const monthName = (ymd: string) => fmtRiyadh(new Date(`${ymd}T12:00:00Z`), { month: 'long', year: 'numeric' });
---

<AdminLayout
  title={post.title}
  lead={`${post.author?.name || post.author_name || 'Unknown author'} · ${post.category} · ${post.status.replace('_', ' ')}`}
>
  <div class="app" style="grid-template-columns: minmax(0, 1fr) 320px">
    <article class="prose" dir={post.dir} data-prose style="max-width:none">
      <Fragment set:html={post.content_html || '<p>(empty)</p>'} />
    </article>
    <div>
      <form data-astro-reload class="form card" method="post" action={`/api/admin/posts/${post.id}/review`}>
        <h2 class="h3">Decision</h2>
        <div class="field">
          <label for="status">Status</label>
          <select class="select" id="status" name="status">
            {['published', 'changes_requested', 'unpublished', 'submitted', 'draft'].map((s) => (
              <option value={s} selected={s === (post.status === 'submitted' ? 'published' : post.status)}>
                {s.replace('_', ' ')}
              </option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="comment">Note to the author</label>
          <textarea
            class="textarea"
            id="comment"
            name="comment"
            maxlength="1000"
            placeholder="What to change, or a thank-you."
          ></textarea>
          <small>The author gets an email with this note.</small>
        </div>
        <button class="btn" type="submit">
          Save decision
        </button>
        <a class="btn btn--ghost" href={`/me/posts/${post.id}/edit`}>
          Open in editor
        </a>
      </form>
      <div class="card" style="margin-top:16px">
        <h2 class="h3">Featured post</h2>
        {post.featured_month === month ? (
          <form data-astro-reload method="post" action={`/api/admin/posts/${post.id}/review`}>
            <p>Featured on /blog for {monthName(month)}.</p>
            <input type="hidden" name="_action" value="unfeature" />
            <button class="btn btn--small btn--ghost" type="submit">
              Stop featuring
            </button>
          </form>
        ) : post.status !== 'published' ? (
          <p class="hint">Only a published post can be featured.</p>
        ) : (
          <form data-astro-reload method="post" action={`/api/admin/posts/${post.id}/review`}>
            {post.featured_month && <p class="hint">Was featured for {monthName(post.featured_month)}.</p>}
            <input type="hidden" name="_action" value="feature" />
            <button class="btn btn--small" type="submit">
              Feature for {monthName(month)}
            </button>
            {current && (
              <small style="display:block;margin-top:8px">
                Replaces "{current.title}", the featured post this month.
              </small>
            )}
          </form>
        )}
      </div>
      {notes.length > 0 && (
        <div class="card" style="margin-top:16px">
          <h2 class="h3">History</h2>
          <ul>
            {notes.map((n: any) => (
              <li>
                <span class="mono">{String(n.created_at).slice(0, 10)}</span> · <b>{n.status_set?.replace('_', ' ')}</b>{' '}
                · {n.reviewer?.name || 'reviewer'}
                {n.comment && <>: {n.comment}</>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
<script>
  import '../../../scripts/highlight.js';
</script>
