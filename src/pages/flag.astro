---
/* End of the site challenge. Checks the pasted flag in the browser (only a digest ships), then shows
   the solvers list and a form to join it. Solvers are stored in the database and moderated by admins;
   without a database the form opens a prefilled GitHub issue. Kept out of search results. */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/flag.css'; // page-scoped; bundled after global.css
import seedSolvers from '../data/solvers.json';
import { dbReady, serviceReady } from '../lib/env';
import { publicClient } from '../lib/supabase';
import { getSettings } from '../lib/content';
import { t, type Lang } from '../lib/i18n';
const settings = await getSettings();
const solvers = dbReady()
  ? (
      (
        await publicClient()
          .from('flag_solvers')
          .select('name,handle,created_at')
          .eq('approved', true)
          .order('created_at')
      ).data || []
    ).map((r: any) => ({ name: r.name, handle: r.handle, date: String(r.created_at).slice(0, 10) }))
  : (seedSolvers as any[]);
const locale = Astro.currentLocale === 'ar' ? 'ar-SA-u-ca-gregory' : 'en-GB';
const lang = (Astro.currentLocale ?? 'en') as Lang;
const repo = (settings.links.github || 'https://github.com/KFUPM-COMPUTER-CLUB/website').replace(/\/+$/, '');
const cfg = JSON.stringify({
  endpoint: serviceReady() ? '/api/flag/solvers' : '',
  issue: `${repo}/issues/new`,
  messages: {
    secure: t(lang, 'flag.secureConnection'),
    notIt: t(lang, 'flag.notIt'),
    checkFailed: t(lang, 'flag.checkFailed'),
    sending: t(lang, 'flag.sending'),
    sent: t(lang, 'flag.sent'),
    sendFailed: t(lang, 'flag.sendFailed'),
    issueOpened: t(lang, 'flag.issueOpened'),
  },
}).replace(/</g, '\\u003c');
const fmt = (iso: string) => {
  const [y, m, d] = String(iso).split('-').map(Number);
  return y && m && d
    ? new Date(y, m - 1, d).toLocaleDateString(locale, { day: 'numeric', month: 'short', year: 'numeric' })
    : '';
};
---

<BaseLayout title={t(lang, 'flag.title')} description={t(lang, 'flag.description')} noindex={true}>
  <section class="flag" data-bg="#0B1A33" data-flag>
    <div class="container flag__inner">
      <span class="eyebrow">{t(lang, 'flag.eyebrow')}</span>

      <div data-flag-gate>
        <h1 class="h1">{t(lang, 'flag.found')}</h1>
        <p class="lead">{t(lang, 'flag.paste')}</p>
        <form class="flag__form" data-flag-form>
          <label class="flag__label" for="flag-key">
            {t(lang, 'flag.label')}
          </label>
          <input
            id="flag-key"
            class="flag__input"
            type="text"
            required
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            maxlength="80"
            data-flag-input
          />
          <button class="btn" type="submit">
            {t(lang, 'flag.check')}
          </button>
        </form>
        <p class="flag__result" aria-live="polite" data-flag-result></p>
      </div>

      <div data-flag-won hidden>
        <h1 class="h1" tabindex="-1" data-flag-title>
          {t(lang, 'flag.congratulations')}
        </h1>
        <p class="lead">{t(lang, 'flag.wonLead')}</p>

        <h2 class="flag__h">{t(lang, 'flag.solvers')}</h2>
        {solvers.length ? (
          <ol class="flag__solvers">
            {solvers.map((s) => (
              <li>
                <span class="flag__name">{s.name}</span>
                <span class="flag__meta">{[s.handle, fmt(s.date)].filter(Boolean).join(' · ')}</span>
              </li>
            ))}
          </ol>
        ) : (
          <p class="flag__empty">{t(lang, 'flag.noSolvers')}</p>
        )}

        <h2 class="flag__h">{t(lang, 'flag.addName')}</h2>
        <form class="flag__form flag__form--solver" data-solver-form>
          <div class="flag__field">
            <label class="flag__label" for="solver-name">
              {t(lang, 'flag.name')}
            </label>
            <input
              id="solver-name"
              class="flag__input"
              type="text"
              required
              maxlength="40"
              autocomplete="name"
              data-solver-name
            />
          </div>
          <div class="flag__field">
            <label class="flag__label" for="solver-handle">
              {t(lang, 'flag.handle')}
            </label>
            <input
              id="solver-handle"
              class="flag__input"
              type="text"
              maxlength="40"
              placeholder={t(lang, 'flag.handlePlaceholder')}
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              data-solver-handle
            />
          </div>
          <button class="btn" type="submit" data-solver-submit>
            {t(lang, 'flag.addName')}
          </button>
        </form>
        <p class="flag__result" aria-live="polite" data-solver-result></p>
      </div>
    </div>
    <script type="application/json" data-flag-cfg set:html={cfg}></script>
  </section>
</BaseLayout>

<script>
  import '../scripts/flag.js';
</script>
