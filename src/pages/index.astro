---
import { Image } from 'astro:assets';
import logoColor from '../assets/brand/logo-color.png';
import kfupmLogo from '../assets/brand/kfupm-logo.png';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import { colorOf } from '../lib/colors.js';
import Collage from '../components/Collage.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import Partners from '../components/Partners.astro';
import ShowReel from '../components/ShowReel.astro';
import Stories from '../components/Stories.astro';
import PhotoMoment from '../components/PhotoMoment.astro';

const isReal = (v) => typeof v === 'string' && !v.includes('REPLACE');
const link = (key, fallback) => (isReal(site.links[key]) ? site.links[key] : fallback);
const ext = (href) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});

const today = new Date(); today.setUTCHours(0, 0, 0, 0);
const events = (await getCollection('events')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const upcoming = events.filter((e) => e.data.date.valueOf() >= today.valueOf());
const past = events.filter((e) => e.data.date.valueOf() < today.valueOf());
const next = upcoming.find((e) => e.data.featured) ?? upcoming[0];
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const iso = (d) => d.toISOString().slice(0, 10);
const short = (d) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const weekday = (d) => d.toLocaleDateString('en-GB', { weekday: 'short', timeZone: 'UTC' });

const history = [
  ...past.map((e) => ({ kind: e.data.type, date: e.data.date, title: e.data.title, text: e.data.summary, href: e.data.detailsUrl })),
  ...posts.map((p) => ({ kind: p.data.category, date: p.data.date, title: p.data.title, text: p.data.excerpt, href: `/blog/${p.id}` })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 6);
const stageTabs = ['Moments', 'In pictures'];
const whatWeDo = [
  { c: 'blue', k: 'WS', t: 'Workshops', d: 'Hands-on sessions from zero to shipped. Git, web, AI, security, and whatever members ask for.' },
  { c: 'blue', k: 'HK', t: 'Hackathons', d: 'Build nights and 24-hour sprints with mentors on the floor. Ship something, then write about it.' },
  { c: 'blue', k: 'TK', t: 'Talks', d: 'Alumni, engineers, and researchers answering the questions you actually have.' },
  { c: 'blue', k: 'CP', t: 'Competitions', d: 'Coding, typing, CTF and puzzle contests with real prize pools, on campus and with other clubs.' },
];
---

<BaseLayout title="Home">
  <!-- Screen 1: logo and headline only -->
  <section class="screen screen--one bg-white" data-bg="#FFFFFF" data-hero>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container screen__inner" data-hero-inner>
      <Image class="hero__logo" src={logoColor} alt={site.name} width={1100} densities={[1, 1.5]} loading="eager" />
      <h1 class="h-display hero__title">Where curious minds build <span class="hl">the future.</span></h1>
    </div>
    <div class="scroll-hint" aria-hidden="true"><span class="mono">Scroll</span><i></i></div>
  </section>

  <!-- Screen 2: CC x KFUPM pinned in the top half; the block under it steps between the photo strip and the moments -->
  <section class="screen screen--two bg-navy" data-bg="#0B1A33" data-stage>
    <Collage />
    <div class="stage__anchor" aria-hidden="true"></div>
    <div class="stage">
      <div class="container stage__top">
        <span class="ccmark reveal" aria-label="CC KFUPM"><b>CC</b><Image src={kfupmLogo} alt="KFUPM" height={76} densities={[1, 2]} /></span>
        <p class="stage__line">{site.intro}</p>
        <div class="stage__bar" role="tablist" aria-label="Sections">
          {stageTabs.map((t, i) => <button class="stage__tab" role="tab" type="button" data-tab={i} aria-selected={i === 0 ? 'true' : 'false'}><i aria-hidden="true"></i><span>{t}</span></button>)}
        </div>
      </div>
      <div class="stage__panels">
        <div class="stage__panel stage__panel--stories" role="tabpanel" data-panel="0" data-active>
          <Stories />
        </div>
        <div class="stage__panel stage__panel--strip" role="tabpanel" data-panel="1">
          <div class="container stage__head"><div><span class="eyebrow">In pictures</span><h2 class="h3">Six years of building</h2></div><a class="link-arrow" href="https://x.com/KFUPM_CC" target="_blank" rel="noopener">More on X ↗</a></div>
          <PhotoStrip />
        </div>
      </div>
    </div>
    <div class="fade fade--to-black" aria-hidden="true"></div>
  </section>

  <ShowReel />

  <PhotoMoment photo="2025-04-10_1910478806520914205.jpg" eyebrow="Techathon 2025, day one" line="Any major. Any year. No experience required." />

  <!-- Join -->
  <section class="section join bg-black" data-bg="#0B0B0F" id="join">
    <div class="container join__inner reveal">
      <h2 class="h1">Build with us.</h2>
      <p class="lead lead--muted">Workshops, hackathons, talks and competitions, all term long. Free for KFUPM students.</p>
      <div class="hero__actions">
        <a class="btn" data-magnet href={link('join', '/about')} {...ext(link('join', '/about'))}>Become a member <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/timeline">See what's coming <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <Partners />
</BaseLayout>

<script>
  import '../scripts/parallax.js';
  import '../scripts/hero-pin.js';
  import '../scripts/stage.js';
</script>

<script>
  import { onPage, reduceMotion } from '../scripts/page.js';
  onPage(() => {
    const reduce = reduceMotion();
    document.querySelectorAll('[data-count]').forEach((el) => {
      const raw = el.dataset.count || ''; const n = parseInt(raw.replace(/\D/g, ''), 10); if (!n || reduce) return;
      const suffix = raw.replace(/^[\d,]+/, ''); const start = performance.now();
      const step = (t) => { const p = Math.min(1, (t - start) / 1200); el.textContent = Math.round(n * (1 - Math.pow(1 - p, 3))) + suffix; if (p < 1) requestAnimationFrame(step); };
      requestAnimationFrame(step);
    });
    const t = new Date(); const todayIso = `${t.getFullYear()}-${String(t.getMonth() + 1).padStart(2, '0')}-${String(t.getDate()).padStart(2, '0')}`;
    document.querySelectorAll('[data-date]').forEach((el) => { if ((el.getAttribute('data-date') || '') < todayIso) el.remove(); });
  });
</script>
