---
import { Image } from 'astro:assets';
import logoColor from '../data/brand/logo-color.png';
import kfupmLogo from '../data/brand/kfupm-logo.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import Collage from '../components/Collage.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import Partners from '../components/Partners.astro';
import ShowReel from '../components/ShowReel.astro';
import Stories from '../components/Stories.astro';
import PhotoMoment from '../components/PhotoMoment.astro';
import { getSettings, getMemberCount } from '../lib/content';
import { t, localePath, type Lang } from '../lib/i18n';

const settings = await getSettings();
const lang = (Astro.currentLocale ?? 'en') as Lang;
const memberCount = await getMemberCount();
const site = settings.site;
const home = settings.home;
const joinHref = settings.links.join || '/join';
const ext = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
// The last two words of the hero line are highlighted.
const heroLine = lang === 'ar' ? t(lang, 'home.hero') : home.heroLine;
const words = heroLine.trim().split(/\s+/);
const heroHead = words.slice(0, -2).join(' ');
const heroTail = words.slice(-2).join(' ');
const stageTabs = [
  { label: t(lang, 'home.moments'), key: 'home.moments' as const },
  { label: t(lang, 'home.inPictures'), key: 'home.inPictures' as const },
];
---

<BaseLayout title={lang === 'ar' ? 'الرئيسية' : 'Home'}>
  <!-- Screen 1: logo and headline only -->
  <section class="screen screen--one bg-white" data-bg="#FFFFFF" data-hero>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container screen__inner" data-hero-inner>
      <Image class="hero__logo" src={logoColor} alt={site.name} width={1100} densities={[1, 1.5]} loading="eager" />
      <h1 class="h-display hero__title">
        {heroHead} <span class="hl">{heroTail}</span>
      </h1>
    </div>
    <div class="scroll-hint" aria-hidden="true">
      <span class="mono">{t(lang, 'home.scroll')}</span>
      <i></i>
    </div>
  </section>

  <!-- Screen 2: CC x KFUPM pinned in the top half; the block under it steps between the photo strip and the moments -->
  <section class="screen screen--two bg-navy" data-bg="#0B1A33" data-stage>
    <Collage />
    <div class="stage__anchor" aria-hidden="true"></div>
    <div class="stage">
      <div class="container stage__top">
        <span class="ccmark reveal" aria-label="CC KFUPM">
          <b>CC</b>
          <Image src={kfupmLogo} alt="KFUPM" height={76} densities={[1, 2]} />
        </span>
        <p class="stage__line">{lang === 'ar' ? t(lang, 'home.intro') : site.intro}</p>
        <div class="stage__bar" role="tablist" aria-label={t(lang, 'home.sections')}>
          {stageTabs.map((tab, i) => (
            <button class="stage__tab" role="tab" type="button" data-tab={i} aria-selected={i === 0 ? 'true' : 'false'}>
              <i aria-hidden="true"></i>
              <span>{tab.label}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="stage__panels">
        <div class="stage__panel stage__panel--stories" role="tabpanel" data-panel="0" data-active>
          <Stories />
        </div>
        <div class="stage__panel stage__panel--strip" role="tabpanel" data-panel="1">
          <div class="container stage__head">
            <div>
              <span class="eyebrow">{t(lang, 'home.inPictures')}</span>
              <h2 class="h3">{t(lang, 'home.yearsBuilding')}</h2>
            </div>
            <a class="link-arrow" href="https://x.com/KFUPM_CC" target="_blank" rel="noopener">
              {t(lang, 'home.moreOnX')} ↗
            </a>
          </div>
          <PhotoStrip />
        </div>
      </div>
    </div>
    <div class="fade fade--to-black" aria-hidden="true"></div>
  </section>

  <ShowReel />

  <PhotoMoment
    photoKey={home.photoMoment.photoKey}
    eyebrow={lang === 'ar' ? t(lang, 'home.momentEyebrow') : home.photoMoment.eyebrow}
    line={lang === 'ar' ? t(lang, 'home.momentLine') : home.photoMoment.line}
  />

  <!-- Join -->
  <section class="section join bg-black" data-bg="#0B0B0F" id="join">
    <div class="container join__inner reveal">
      <h2 class="h1">{lang === 'ar' ? t(lang, 'home.buildTitle') : home.buildWithUs.title}</h2>
      {memberCount !== null && (
        <p class="lead lead--muted">
          {memberCount.toLocaleString(lang === 'ar' ? 'ar-SA' : 'en-US')} {t(lang, 'home.membersGrowing')}
        </p>
      )}
      <p class="lead lead--muted">{lang === 'ar' ? t(lang, 'home.buildText') : home.buildWithUs.text}</p>
      <div class="hero__actions">
        <a class="btn" data-magnet href={joinHref} {...ext(joinHref)}>
          {t(lang, 'home.becomeMember')} <span aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={localePath(lang, '/timeline')}>
          {t(lang, 'home.seeComing')} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
  <Partners />
</BaseLayout>

<script>
  import '../scripts/parallax.js';
  import '../scripts/hero-pin.js';
  import '../scripts/stage.js';
</script>

<script>
  import '../scripts/home.js';
</script>
