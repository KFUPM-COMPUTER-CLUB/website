---
/* Events: upcoming first, then past grouped by semester. Every event links to its X post; upcoming
   ones get calendar links and, when registration is open, a one-click reservation for members.
   The page is cached for everyone, so it renders both the reservation form and the sign-in link and
   lets account.js show the right one from the cc_in cookie. Spot counts come from registration_counts(),
   a security-definer function that returns numbers without exposing who registered. "Full" here is
   advisory: the API makes the real capacity check when the form is posted. */
import BaseLayout from '../layouts/BaseLayout.astro';
import BackToTop from '../components/BackToTop.astro';
import { getUpcomingEvents, getPastEvents, getResults, termOf, riyadhDate, fmtRiyadh, ordinal } from '../lib/content';
import { googleUrl, outlookUrl } from '../lib/calendar';
import { dbReady } from '../lib/env';
import { publicClient } from '../lib/supabase';
import { hasResults, type EventItem, type EventResult } from '../lib/types';
import { t, dateLocale, localePath, localizeTerm, eventTypeLabel, type Lang } from '../lib/i18n';
import Money from '../components/Money.astro';

const [upcoming, past, results] = await Promise.all([getUpcomingEvents(), getPastEvents(), getResults()]);
const lang = (Astro.currentLocale ?? 'en') as Lang;
const locale = dateLocale(Astro.currentLocale);
// "1st" in English, "المركز 1" in Arabic.
const place = (n: number) => (lang === 'ar' ? `${t(lang, 'results.place')} ${n}` : ordinal(n));
// Who placed: the member's name (linked while their profile is public), with the team name when there is one.
const winner = (r: EventResult) =>
  r.team && r.name ? `${r.team} (${r.name})` : r.team || r.name || t(lang, 'blog.aMember');
const site = Astro.site?.origin || '';
const counts = new Map<string, number>();
const open = upcoming.filter((e) => e.registrationOpen);
if (dbReady() && open.length) {
  const { data } = await publicClient().rpc('registration_counts', { p_event_ids: open.map((e) => e.id) });
  for (const r of data || []) counts.set(r.event_id, Number(r.count) || 0);
}
const groups = (list: EventItem[]) => {
  const out: { term: string; items: EventItem[] }[] = [];
  for (const e of list) {
    const t = termOf(e.start);
    const g = out.find((x) => x.term === t);
    if (g) g.items.push(e);
    else out.push({ term: t, items: [e] });
  }
  return out;
};
const day = (d: Date) => fmtRiyadh(d, { month: 'short', day: 'numeric' }, locale);
const when = (e: EventItem) =>
  (e.end && riyadhDate(e.end) !== riyadhDate(e.start) ? `${day(e.start)} – ${day(e.end)}` : day(e.start)) +
  (e.allDay ? '' : ` · ${fmtRiyadh(e.start, { hour: 'numeric', minute: '2-digit' }, locale)}`);
const calData = JSON.stringify(
  [...upcoming, ...past].map((e) => ({
    d: riyadhDate(e.start),
    e: e.end ? riyadhDate(e.end) : undefined,
    t: e.title,
    id: e.slug,
  })),
);
// Thumbnails share a view-transition name with the same photo on the home page, so it morphs into place.
const seen = new Set<string>();
const morph = (key: string | null) => {
  if (!key) return undefined;
  const n = `photo-${key.replace(/\.[a-z]+$/i, '')}`;
  if (seen.has(n)) return undefined;
  seen.add(n);
  return n;
};
const spots = (e: EventItem) =>
  e.capacity
    ? `${Math.min(counts.get(e.id) || 0, e.capacity)} / ${e.capacity} ${t(lang, 'timeline.spotsTaken')}`
    : `${counts.get(e.id) || 0} ${t(lang, 'timeline.going')}`;
const full = (e: EventItem) => !!e.capacity && (counts.get(e.id) || 0) >= e.capacity;
---

<BaseLayout title={t(lang, 'timeline.title')} description={t(lang, 'timeline.description')}>
  <section class="page-head page-head--compact">
    <div class="container">
      <h1 class="ccmark ccmark--text" aria-label={`CC ${t(lang, 'timeline.events')}`}>
        <b>CC</b>
        <span>{t(lang, 'timeline.events')}</span>
      </h1>
      <p class="lead">{t(lang, 'timeline.lead')}</p>
    </div>
  </section>

  <section class="section events">
    <div class="container events__grid">
      <div class="events__list">
        {[
          { title: t(lang, 'timeline.upcoming'), list: upcoming, up: true },
          { title: t(lang, 'timeline.past'), list: past, up: false },
        ].map((sec) => (
          <div class="events__section" data-section>
            <h2 class="h2">{sec.title}</h2>
            {sec.list.length === 0 && <p class="lead lead--muted">{t(lang, 'timeline.empty')}</p>}
            {groups(sec.list).map((g) => (
              <div class="term" data-term>
                <div class="term__label mono">
                  <i aria-hidden="true"></i>
                  {localizeTerm(lang, g.term)}
                </div>
                {g.items.map((e) => (
                  <article class="ev" id={`ev-${e.slug}`} data-type={e.type}>
                    {e.cover ? (
                      e.xUrl ? (
                        <a
                          class="ev__thumb-link"
                          href={e.xUrl}
                          target="_blank"
                          rel="noopener"
                          aria-label={`${e.title} on X`}
                          transition:name={morph(e.coverKey)}
                        >
                          <img
                            class="ev__thumb"
                            src={e.cover.src}
                            srcset={e.cover.srcset}
                            sizes="168px"
                            alt=""
                            width="168"
                            height="168"
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                      ) : (
                        <img class="ev__thumb" src={e.cover.src} alt="" width="168" height="168" loading="lazy" />
                      )
                    ) : (
                      <span class="ev__thumb ev__thumb--empty" aria-hidden="true">
                        CC
                      </span>
                    )}
                    <div class="ev__body">
                      <p class="ev__when mono">
                        <time datetime={e.start.toISOString()}>{when(e)}</time>
                      </p>
                      <h3 class="ev__title">
                        {e.xUrl ? (
                          <a href={e.xUrl} target="_blank" rel="noopener">
                            {e.title}
                          </a>
                        ) : (
                          e.title
                        )}
                      </h3>
                      <p class="ev__where mono">{e.location}</p>
                      <p class="ev__summary">{e.summary}</p>
                      {!sec.up && hasResults(e.type) && results.get(e.id)?.length ? (
                        <div class="ev__results">
                          <p class="mono">{t(lang, 'timeline.results')}</p>
                          <ol>
                            {results.get(e.id)!.map((r) => (
                              <li>
                                <b>{place(r.place)}</b>{' '}
                                {r.handle ? (
                                  <a href={localePath(lang, `/u/${r.handle}`)}>{winner(r)}</a>
                                ) : (
                                  <span>{winner(r)}</span>
                                )}
                                {r.prizeSar ? (
                                  <span class="mono">
                                    {' '}
                                    · <Money>{r.prizeSar.toLocaleString('en-US')}</Money>
                                  </span>
                                ) : null}
                              </li>
                            ))}
                          </ol>
                        </div>
                      ) : null}
                      {sec.up && (
                        <p class="ev__cal">
                          {e.registerUrl && (
                            <a class="ev__register" href={e.registerUrl} target="_blank" rel="noopener">
                              {t(lang, 'timeline.register')} ↗
                            </a>
                          )}
                          <span class="mono">{t(lang, 'timeline.addTo')}</span>
                          <a href={googleUrl(e, site)} target="_blank" rel="noopener">
                            Google
                          </a>
                          <a
                            href={outlookUrl(e, 'work', site)}
                            target="_blank"
                            rel="noopener"
                            title={t(lang, 'timeline.outlookWork')}
                          >
                            Outlook
                          </a>
                          <a
                            href={outlookUrl(e, 'personal', site)}
                            target="_blank"
                            rel="noopener"
                            title={t(lang, 'timeline.outlookPersonal')}
                          >
                            Outlook.com
                          </a>
                          <a href={`/api/events/${e.slug}.ics`} download={`${e.slug}.ics`}>
                            .ics
                          </a>
                        </p>
                      )}
                      {sec.up && e.registrationOpen && (
                        <div class="ev__rsvp">
                          <form
                            data-astro-reload
                            method="post"
                            action={`/api/events/${e.id}/register`}
                            data-signed-in
                            hidden
                          >
                            <input type="hidden" name="next" value={`/timeline#ev-${e.slug}`} />
                            <label class="ev__copy">
                              <input type="checkbox" name="email_copy" value="1" /> {t(lang, 'timeline.emailCopy')}
                            </label>
                            <button class="btn btn--small" type="submit" disabled={full(e)}>
                              {full(e) ? t(lang, 'timeline.full') : t(lang, 'timeline.reserve')}{' '}
                              <span aria-hidden="true">→</span>
                            </button>
                          </form>
                          <a
                            class="btn btn--small btn--ghost"
                            data-signed-out
                            href={`/join?next=${encodeURIComponent(`/timeline#ev-${e.slug}`)}`}
                          >
                            {t(lang, 'timeline.signInReserve')}
                          </a>
                          <span class="mono ev__spots">{spots(e)}</span>
                        </div>
                      )}
                    </div>
                    <span class="tag ev__tag">{eventTypeLabel(lang, e.type)}</span>
                  </article>
                ))}
              </div>
            ))}
          </div>
        ))}
      </div>

      <aside class="events__side">
        <div class="cal" data-events={calData}>
          <div class="cal__head">
            <span class="mono">{t(lang, 'timeline.calendar')}</span>
            <a class="cal__ics" href="/calendar.ics" download="kfupm-computer-club.ics">
              {t(lang, 'timeline.addIcal')}
            </a>
          </div>
          <div class="cal__nav">
            <strong class="cal__month"></strong>
            <span>
              <button type="button" class="cal__prev" aria-label={t(lang, 'timeline.previousMonth')}>
                ‹
              </button>
              <button type="button" class="cal__next" aria-label={t(lang, 'timeline.nextMonth')}>
                ›
              </button>
            </span>
          </div>
          <div class="cal__grid" role="grid"></div>
          <p class="cal__hint mono">{t(lang, 'timeline.calendarHint')}</p>
        </div>
      </aside>
    </div>
  </section>
  <BackToTop slot="floating" />
</BaseLayout>

<script>
  import '../scripts/mini-calendar.js';
</script>
