# Copy to .env for local development. Every variable is optional: without the Supabase values the
# site serves the seed data in src/data and sign-in is switched off. Never commit .env.

# Supabase (Project Settings → API). The URL and the publishable key are public by design.
PUBLIC_SUPABASE_URL=                # https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=    # sb_publishable_… (older projects: PUBLIC_SUPABASE_ANON_KEY with the anon key)
SUPABASE_SECRET_KEY=                # sb_secret_… server only; the API writes with it (older projects: SUPABASE_SERVICE_ROLE_KEY)

# Accounts
ADMIN_EMAILS=                       # comma-separated emails that become admin on first sign-in
PUBLIC_GOOGLE_SIGNIN=               # Google button is on by default; set to "false" to hide it

# Email (Resend). Mail stays queued in the database until both are set.
RESEND_API_KEY=                     # re_… from resend.com → API Keys
EMAIL_FROM=                         # "KFUPM Computer Club <hello@example.com>" on a domain verified in Resend

# Deployment
SITE_URL=                           # production address, used in emails and feeds; e.g. https://cckfupm.vercel.app
CRON_SECRET=                        # any long random string; Vercel sends it with the daily and weekly cron calls
