# Copy to .env for local development. Every variable is optional: without Supabase the site serves
# the seed data in src/data and sign-in is switched off.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=         # or PUBLIC_SUPABASE_PUBLISHABLE_KEY (sb_publishable_…)
SUPABASE_SERVICE_ROLE_KEY=        # or SUPABASE_SECRET_KEY (sb_secret_…)
ADMIN_EMAILS=            # comma-separated; these accounts become admins on first sign-in
PUBLIC_GOOGLE_SIGNIN=    # on by default; set to "false" to hide the Google button
RESEND_API_KEY=          # email stays queued until this is set
EMAIL_FROM=              # e.g. "KFUPM Computer Club <hello@example.com>" (a verified Resend domain)
CRON_SECRET=             # set by Vercel for cron jobs; verified when present
SITE_URL=                # production URL, used for links in emails and feeds
